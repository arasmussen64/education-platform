#!/usr/bin/python3
"""lab-imds: a stand-in for a cloud's instance metadata service, answering
at http://169.254.169.254/ the way EC2's does. Part of the lab's scenery.

It hands out the instance's identity, its user data, and temporary
credentials for the instance's role (fake ones, for the lab). It speaks both
protocols: plain GETs (IMDSv1) and session tokens (IMDSv2: PUT
/latest/api/token with an X-aws-ec2-metadata-token-ttl-seconds header, then
the token in X-aws-ec2-metadata-token on every GET). /etc/lab/imds.conf
says whether plain GETs are still allowed (tokens=optional) or refused with
401 (tokens=required); it's read on every request, so the lab's "console"
stand-in, lab-imds-options, only has to write the file.
"""

import json
import secrets
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

CONF = Path("/etc/lab/imds.conf")
INSTANCE_ID = Path("/etc/lab/instance-id")
USER_DATA = Path("/var/lib/cloud/seed/nocloud/user-data")
TOKEN_HEADER = "X-aws-ec2-metadata-token"
TTL_HEADER = "X-aws-ec2-metadata-token-ttl-seconds"
MAX_TTL = 21600

tokens = {}  # token -> expiry time


def tokens_required():
    try:
        for line in CONF.read_text().splitlines():
            if line.strip() == "tokens=required":
                return True
    except OSError:
        pass
    return False


def instance_id():
    try:
        return INSTANCE_ID.read_text().strip()
    except OSError:
        return "i-0000000000000000"


def credentials():
    expiry = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + 6 * 3600))
    return json.dumps(
        {
            "Code": "Success",
            "Type": "AWS-HMAC",
            "AccessKeyId": "ASIAFAKEFORTHELAB0001",
            "SecretAccessKey": "fake/secret/for/the/lab/only/" + instance_id(),
            "Token": "FwoGZXIvYXdzEFakeSessionTokenForTheLabOnly==",
            "Expiration": expiry,
        },
        indent=2,
    )


def tree():
    """The metadata, as paths. Entries ending in / are directories."""
    return {
        "/latest/": "meta-data/\nuser-data\napi/",
        "/latest/meta-data/": "instance-id\nlocal-hostname\nplacement/\niam/",
        "/latest/meta-data/instance-id": instance_id(),
        "/latest/meta-data/local-hostname": "shop-1",
        "/latest/meta-data/placement/": "availability-zone\nregion",
        "/latest/meta-data/placement/availability-zone": "eu-west-1a",
        "/latest/meta-data/placement/region": "eu-west-1",
        "/latest/meta-data/iam/": "security-credentials/",
        "/latest/meta-data/iam/security-credentials/": "shop-role",
        "/latest/meta-data/iam/security-credentials/shop-role": credentials(),
        "/latest/user-data": USER_DATA.read_text() if USER_DATA.exists() else "",
    }


class Handler(BaseHTTPRequestHandler):
    def reply(self, status, body):
        data = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def token_is_valid(self):
        token = self.headers.get(TOKEN_HEADER)
        return token in tokens and tokens[token] > time.time()

    def do_PUT(self):
        if self.path != "/latest/api/token":
            return self.reply(404, "not found\n")
        ttl = self.headers.get(TTL_HEADER)
        if ttl is None or not ttl.isdigit() or not 1 <= int(ttl) <= MAX_TTL:
            return self.reply(400, f"a {TTL_HEADER} header between 1 and {MAX_TTL} is required\n")
        token = secrets.token_urlsafe(32)
        tokens[token] = time.time() + int(ttl)
        self.reply(200, token)

    def do_GET(self):
        if tokens_required() and not self.token_is_valid():
            return self.reply(401, "unauthorized: a session token is required (IMDSv2)\n")
        if self.headers.get(TOKEN_HEADER) and not self.token_is_valid():
            return self.reply(401, "unauthorized: that session token is not valid\n")
        body = tree().get(self.path)
        if body is None:
            return self.reply(404, "not found\n")
        self.reply(200, body if body.endswith("\n") else body + "\n")

    do_HEAD = do_GET

    def log_message(self, format, *args):
        mode = "tokens required" if tokens_required() else "tokens optional"
        token = "with token" if self.headers.get(TOKEN_HEADER) else "no token"
        print(f"{self.command} {self.path} from {self.client_address[0]} ({token}; {mode}): {format % args}", flush=True)


print("lab-imds listening on 169.254.169.254:80", flush=True)
HTTPServer(("169.254.169.254", 80), Handler).serve_forever()

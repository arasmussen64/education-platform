#cloud-config
# The shop's web servers configure themselves from this. Four values are
# missing, marked with ... ; fill them in so a launched instance installs
# the report tool, writes its config and leaves a readiness marker.
users:
  - name: ben
    groups: sudo
    shell: /bin/bash
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeKeyForTheLabOnly0000000000000000000000000 ben@laptop
packages:
  - ...
write_files:
  - path: /etc/shop/...
    content: |
      SHOP_TIER=...
runcmd:
  - ...

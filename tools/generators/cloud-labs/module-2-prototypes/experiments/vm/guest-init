#!/bin/sh
# The guest's whole userland: say what this machine looks like from inside,
# then switch off.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
for m in /lib/modules/*.ko; do [ -e "$m" ] && insmod "$m" 2>/dev/null; done
sleep 1
echo "=== guest report"
echo "cpus: $(grep -c ^processor /proc/cpuinfo)"
echo "memory_kb: $(awk '/^MemTotal/ {print $2}' /proc/meminfo)"
echo "hypervisor_flag: $(grep -m1 -c -w hypervisor /proc/cpuinfo)"
echo "dmesg_hypervisor: $(dmesg | grep -m1 -i 'hypervisor detected' | sed 's/^\[[^]]*\] //')"
echo "dmi_vendor: $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)"
echo "dmi_product: $(cat /sys/class/dmi/id/product_name 2>/dev/null)"
echo "clocksource: $(cat /sys/devices/system/clocksource/clocksource0/current_clocksource)"
for n in /sys/class/net/*; do
  name=$(basename "$n"); [ "$name" = lo ] && continue
  echo "nic: $name driver=$(basename "$(readlink "$n/device/driver")")"
done
for b in /sys/block/*; do
  name=$(basename "$b"); case "$name" in loop*|ram*) continue;; esac
  drv=$(basename "$(readlink "$b/device/driver" 2>/dev/null)")
  echo "disk: $name driver=$drv"
done
echo "virtio_devices: $(ls /sys/bus/virtio/devices 2>/dev/null | wc -l)"
echo "pci:"; lspci 2>/dev/null
echo "=== end"
poweroff -f

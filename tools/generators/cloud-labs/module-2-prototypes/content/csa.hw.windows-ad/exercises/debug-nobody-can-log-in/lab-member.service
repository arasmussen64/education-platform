# Puts this machine in the state the exercise starts from, once, at the
# lab's first boot: joined long ago, then broken. Part of the scenery.
[Unit]
Description=The lab's story so far
After=lab-dc.service dnsmasq.service dbus.service polkit.service
Requires=lab-dc.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStart=/usr/local/lib/lab/member-seed.sh

[Install]
WantedBy=multi-user.target

# origin: sets the caching headers
server {
  listen 8001;
  root /srv/www;
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location = /index.html { add_header Cache-Control "no-cache"; }
  location /account { proxy_pass http://127.0.0.1:8080; add_header Cache-Control "public, max-age=60"; }
}
# edge: a shared cache that obeys the origin
proxy_cache_path /var/cache/nginx/edge keys_zone=edge:10m;
server {
  listen 8000;
  location / { proxy_pass http://127.0.0.1:8001; proxy_cache edge; add_header X-Cache-Status $upstream_cache_status always; }
}

server {
  listen 8443 ssl;
  server_name api.shop.test;
  ssl_certificate /etc/ssl/lab/www-fullchain.pem;
  ssl_certificate_key /etc/ssl/lab/www.key;
  ssl_client_certificate /etc/ssl/lab/clientca.pem;
  ssl_verify_client on;
  location / { return 200 "partner $ssl_client_s_dn verified=$ssl_client_verify\n"; }
}

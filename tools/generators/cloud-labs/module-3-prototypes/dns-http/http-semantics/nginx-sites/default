server {
  listen 443 ssl http2;
  server_name www.shop.test;
  ssl_certificate /etc/ssl/lab/www-fullchain.pem;
  ssl_certificate_key /etc/ssl/lab/www.key;
  ssl_stapling on;
  ssl_stapling_verify on;
  ssl_trusted_certificate /etc/ssl/lab/trusted.pem;
  location / { return 200 "hello from www\n"; }
}

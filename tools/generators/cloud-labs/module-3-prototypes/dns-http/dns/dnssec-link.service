[Unit]
Description=Link the DNSSEC chain (DS records up to the root, trust anchor)
After=ns@root.service ns@tld.service ns@ns1.service ns@ns2.service
Wants=ns@root.service ns@tld.service ns@ns1.service ns@ns2.service
[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/usr/local/lib/lab/dnssec-link.sh
[Install]
WantedBy=multi-user.target

# Builds the lab's network at boot (/usr/local/lib/netlab/netlab up, from
# /etc/netlab/topology): the machines, their cables and switches, their
# addresses and settings. Part of the lab's scenery, as a cloud's network is.
[Unit]
Description=The lab's network: its machines, cables and switches
DefaultDependencies=no
After=local-fs.target
Before=network.target multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/netlab/netlab up

[Install]
WantedBy=multi-user.target

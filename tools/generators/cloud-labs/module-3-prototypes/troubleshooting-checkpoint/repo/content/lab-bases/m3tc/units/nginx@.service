# nginx on one of the lab's machines: "systemctl status nginx@web1". Its
# configuration is the machine's /etc/nginx.
[Unit]
Description=nginx on %i
After=netlab.service
Requires=netlab.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/sbin/nginx -t -q
ExecStart=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/sbin/nginx -g 'daemon off; master_process on;'
ExecReload=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/sbin/nginx -s reload
Restart=on-failure

[Install]
WantedBy=multi-user.target

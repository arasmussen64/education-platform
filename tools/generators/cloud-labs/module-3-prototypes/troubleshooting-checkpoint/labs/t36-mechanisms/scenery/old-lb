#!/bin/bash
# The old load balancer's leftover service on lbold: it takes the service
# address and announces it every 20 seconds, as its failover software did,
# and answers web requests with its maintenance page.
ip addr add 10.20.0.80/24 dev eth0 2>/dev/null
python3 -c '
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
class H(BaseHTTPRequestHandler):
    def do_GET(self):
        b = b"down for maintenance\n"
        self.send_response(503); self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
    def log_message(self, *a): pass
ThreadingHTTPServer(("10.20.0.80", 80), H).serve_forever()' &
while true; do arping -q -U -c 1 -I eth0 10.20.0.80; sleep 20; done

#!/usr/bin/python3
"""shop-db: the shop's database (stand-in). Says ok to each connection."""
import socket
s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("0.0.0.0", 5432)); s.listen(64)
while True:
    c, _ = s.accept()
    try: c.sendall(b"ok\n")
    except OSError: pass
    c.close()

#!/usr/bin/python3
"""shop-web: one of the shop's web servers (stand-in). Answers on port 8080.
/            the shop's front page, which needs nothing else
/orders      needs the database at 10.0.1.20:5432
/health      a deep check: answers 200 only if the database answers
/livez       a shallow check: 200 if this server can answer at all
/slow?s=N    a slow download, N seconds long (for draining)
FLAKY=N in the environment makes every Nth /livez answer take 1.5 s."""
import os, socket, sys, time, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs
NAME = os.environ.get("NAME", socket.gethostname())
FLAKY = int(os.environ.get("FLAKY", "0"))
counter = {"livez": 0}
lock = threading.Lock()
def db_ok():
    try:
        with socket.create_connection(("10.0.1.20", 5432), timeout=0.5) as s:
            return s.recv(16).startswith(b"ok")
    except OSError:
        return False
class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, *a): pass
    def send(self, code, body):
        b = body.encode()
        self.send_response(code); self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(b))); self.send_header("X-Served-By", NAME); self.end_headers()
        self.wfile.write(b)
    def do_GET(self):
        u = urlparse(self.path)
        if u.path == "/":
            self.send(200, f"shop front page, served by {NAME}\n")
        elif u.path == "/orders":
            self.send(200, f"orders ok, served by {NAME}\n") if db_ok() else self.send(503, f"orders unavailable: no database, served by {NAME}\n")
        elif u.path == "/health":
            self.send(200, "ok\n") if db_ok() else self.send(503, "database down\n")
        elif u.path == "/livez":
            with lock:
                counter["livez"] += 1; n = counter["livez"]
            if FLAKY and n % FLAKY == 0:
                time.sleep(1.5)
            self.send(200, "alive\n")
        elif u.path == "/slow":
            secs = int(parse_qs(u.query).get("s", ["10"])[0])
            self.send_response(200); self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(secs * 10)); self.send_header("X-Served-By", NAME); self.end_headers()
            for _ in range(secs):
                self.wfile.write(b"0123456789"); self.wfile.flush(); time.sleep(1)
        else:
            self.send(404, "not found\n")
print(f"{NAME} listening on 8080", flush=True)
ThreadingHTTPServer(("0.0.0.0", 8080), H).serve_forever()

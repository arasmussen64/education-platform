#!/bin/bash
# Runs inside the cloud's network namespace, in a mount namespace of its own:
# the cloud gateway's own swanctl and strongSwan settings.
set -euo pipefail
hostname cloud-gw
mount --bind /srv/cloud/swanctl /etc/swanctl
mount --bind /srv/cloud/strongswan.conf /etc/strongswan.conf
mkdir -p /run/cloud
exec "$@"

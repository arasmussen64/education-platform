[Unit]
Description=r1: router advertisements on the office LAN (radvd)
After=netlab.service
BindsTo=netlab.service
PartOf=netlab.service
[Service]
NetworkNamespacePath=/run/netns/r1
ExecStart=/usr/sbin/radvd --nodaemon -C /etc/netlab/r1/radvd.conf -p /run/radvd-r1.pid
Restart=on-failure
[Install]
WantedBy=multi-user.target

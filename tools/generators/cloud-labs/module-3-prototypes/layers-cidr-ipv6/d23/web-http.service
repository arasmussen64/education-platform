[Unit]
Description=web: the shop's web server (in its own machine)
After=netlab.service
BindsTo=netlab.service
PartOf=netlab.service
[Service]
NetworkNamespacePath=/run/netns/web
WorkingDirectory=/srv/web
ExecStart=/usr/bin/python3 -m http.server 80
Restart=always
[Install]
WantedBy=multi-user.target

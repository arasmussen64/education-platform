[Unit]
Description=files: the shop's files server (in its own machine)
After=netlab.service
BindsTo=netlab.service
PartOf=netlab.service
[Service]
NetworkNamespacePath=/run/netns/files
WorkingDirectory=/srv/files
ExecStart=/usr/bin/python3 -m http.server 80
Restart=always
[Install]
WantedBy=multi-user.target

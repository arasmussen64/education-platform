
# A fresh server, nothing set up: the shop's API is installed but not
# enabled or started, there's no firewall, and SSH still takes passwords.
COPY shop-api /usr/local/bin/shop-api
COPY shop-api.service /etc/systemd/system/shop-api.service
RUN chmod 755 /usr/local/bin/shop-api

CMD ["/sbin/init"]

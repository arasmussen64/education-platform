
# The shop's server with everything done except the service: the firewall
# is up and persisted and SSH is hardened; shop-api is installed but not
# enabled or started. That one part is the step.
COPY shop-api /usr/local/bin/shop-api
COPY shop-api.service /etc/systemd/system/shop-api.service
COPY nftables-shop.conf /etc/nftables.conf
COPY 90-hardening.conf /etc/ssh/sshd_config.d/90-hardening.conf
RUN chmod 755 /usr/local/bin/shop-api && chmod 644 /etc/ssh/sshd_config.d/90-hardening.conf \
 && mkdir -p /etc/systemd/system/sysinit.target.wants \
 && ln -s /usr/lib/systemd/system/nftables.service /etc/systemd/system/sysinit.target.wants/nftables.service

CMD ["/sbin/init"]

# Fills the shop's data area at boot (see /usr/local/lib/lab/lab-disk.sh).
# Part of the lab's scenery.
[Unit]
Description=The shop's data area (full)
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/lab/lab-disk.sh

[Install]
WantedBy=multi-user.target

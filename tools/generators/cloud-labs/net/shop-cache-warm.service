# The web tier warming the cache at boot. Part of the lab's scenery.
[Unit]
Description=shop-cache-warm: warm the shop's cache
After=shop-cache.service
Requires=shop-cache.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/shop-cache-warm

[Install]
WantedBy=multi-user.target

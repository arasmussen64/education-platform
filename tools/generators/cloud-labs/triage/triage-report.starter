#!/bin/bash
# Usage: triage-report
# The first-minute signals in one place: the CPU count, the load, the run
# queue, and the busiest process with its CPU share.
echo "cpus: $(...)"
echo "load: $(cut -d' ' -f1 /proc/loadavg)"
echo "run-queue: $(vmstat 1 2 | tail -1 | awk '{print $...}')"
echo "busiest: $(ps -eo comm,%cpu --sort=... | awk 'NR == 2 {print $1}')"
echo "busiest-cpu: $(ps -eo comm,%cpu --sort=-%cpu | awk 'NR == 2 {print $...}')"

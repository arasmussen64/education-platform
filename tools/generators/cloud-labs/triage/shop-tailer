#!/bin/bash
# shop-tailer: meant to pick up jobs from the shop's queue, reading the next
# one from /var/lib/shop/queue/next. That directory was never created on
# this host, so it spins forever retrying the open: a busy loop of failing
# openat calls that burns a whole CPU in the kernel. A runaway to find and
# stop.
while :; do
  read -r _ < /var/lib/shop/queue/next
done 2>/dev/null

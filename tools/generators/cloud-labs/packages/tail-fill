
# The shop's package repository, the server's current packages, and the
# patch script with its gaps.
COPY make-repo.sh /usr/local/lib/lab/make-repo.sh
RUN bash /usr/local/lib/lab/make-repo.sh && rm -r /usr/local/lib/lab
COPY patch-server.starter /home/learner/bin/patch-server
RUN chmod 755 /home/learner/bin/patch-server && chown -R learner:learner /home/learner/bin

CMD ["/sbin/init"]

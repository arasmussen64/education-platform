
# The shop's package repository, the server's current packages, and an
# empty ~/bin for the script.
COPY make-repo.sh /usr/local/lib/lab/make-repo.sh
RUN bash /usr/local/lib/lab/make-repo.sh && rm -r /usr/local/lib/lab \
 && mkdir -p /home/learner/bin && chown learner:learner /home/learner/bin

CMD ["/sbin/init"]

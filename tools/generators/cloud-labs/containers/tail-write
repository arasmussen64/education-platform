
# Three image layers as folders, and an empty ~/bin for the script.
COPY make-layers.sh /usr/local/lib/lab/make-layers.sh
RUN bash /usr/local/lib/lab/make-layers.sh && rm /usr/local/lib/lab/make-layers.sh \
 && mkdir -p /home/learner/bin && chown learner:learner /home/learner/bin

CMD ["/sbin/init"]

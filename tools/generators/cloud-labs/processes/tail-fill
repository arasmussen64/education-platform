
# The report job, and the runner with its gaps, owned by the learner.
COPY make-report.sh /srv/tools/make-report.sh
COPY run-report.starter /home/learner/bin/run-report
RUN chmod 755 /srv/tools/make-report.sh /home/learner/bin/run-report \
 && chown -R learner:learner /home/learner/bin

CMD ["/sbin/init"]

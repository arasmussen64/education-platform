# Settings for the Edge Functions on your PC. Copy this file to
# supabase/functions/.env (which git ignores) and fill it in.
# Never commit the real key, and never paste it into chat.

# The Claude API key (Anthropic Console). Without it, grading says it's
# unavailable, and everything else still works.
ANTHROPIC_API_KEY=

# Optional: which model grades explanations, and how hard it thinks.
# GRADER_MODEL=claude-haiku-5-5
# GRADER_EFFORT=low

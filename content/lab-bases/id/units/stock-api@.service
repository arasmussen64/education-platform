# The shop's stock API (the base's stand-in resource server) on a machine:
# "systemctl status stock-api@api". Its settings are the machine's
# /etc/stock-api/api.conf; it logs why it refused a token.
[Unit]
Description=The stock API on %i
After=netlab.service keycloak@idp.service
Requires=netlab.service
PartOf=netlab.service

[Service]
SyslogIdentifier=%p@%i
ExecStart=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/local/bin/stock-api
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target

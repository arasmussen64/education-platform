#!/bin/bash
# realm-saved [REALM...]: "saved" when the running realm equals a fresh
# build of its file, otherwise how it differs (a change made only with
# kcadm.sh or the admin console shows here, and is lost at the next
# realm-apply).
. /etc/idlab/idp
exec on "$IDP_MACHINE" python3 /usr/local/lib/idlab/kcapi.py saved "$@"

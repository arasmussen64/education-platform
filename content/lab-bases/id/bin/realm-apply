#!/bin/bash
# realm-apply [REALM...]: rebuild a realm (or every realm) from its file,
# /etc/keycloak/realms/REALM.json on the identity provider's machine. The
# same as "sudo systemctl reload keycloak@idp". Works from the lab machine
# or any machine: it goes to the identity provider's machine first, as root.
. /etc/idlab/idp
exec on "$IDP_MACHINE" python3 /usr/local/lib/idlab/kcapi.py apply "$@"

#!/bin/bash
# lab-enter MACHINE [COMMAND...]
# Runs inside "ip netns exec MACHINE", which has already put the command in
# the machine's network namespace, in a mount namespace of its own, with
# each file and folder of /etc/netns/MACHINE/ laid over /etc. This adds the
# rest of what makes a machine: its own /run (so two machines' daemons don't
# share pid files and sockets), its own state folders (/var/cache/bind and
# the like), and its own name. Then it runs COMMAND, or a shell.
# Used by "on" and by every per-machine service (frr@, strongswan@ ...), so
# the learner and the daemons see the same machine.
set -euo pipefail
m=$1
shift
# With no command, a login shell in root's home, as after logging in.
if [[ $# -eq 0 ]]; then
  set -- bash -l
  cd /root
fi

run=/run/netlab/machines/$m
state=/var/lib/netlab/machines/$m
mkdir -p "$run"

# The machine's own /run, with the lab machine's systemd and journal still in
# sight, so systemctl and journalctl work from inside a machine. Bound into
# the machine's folder first, then the folder over /run, taking them along.
for d in systemd log; do
  mkdir -p "$run/$d"
  mount --bind "/run/$d" "$run/$d"
done
mount --rbind "$run" /run

# The machine's own state folders, made from the image's at first use.
# Two commands can enter a machine at the same moment (two of its services
# at boot, a check's "on" beside another), and both would make the same
# folder: cp then fails on a file the other has just made, and this script
# stops. So one at a time makes them, holding a lock beside the folders.
mkdir -p "$state"
exec 9> "$state.lock"
flock 9
for d in /var/cache/bind /var/lib/bind /var/lib/unbound /var/log/frr /var/lib/frr \
         /var/log/nginx /var/lib/nginx /var/lib/haproxy \
         /var/log/apache2 /var/lib/apache2 /var/cache/apache2 \
         /var/lib/chrony /var/log/chrony; do
  [[ -d $d ]] || continue
  if [[ ! -d $state$d ]]; then
    mkdir -p "$state$d"
    cp -a "$d/." "$state$d/"
    chown --reference="$d" "$state$d"
    chmod --reference="$d" "$state$d"
  fi
  mount --bind "$state$d" "$d"
done
# Let go of the lock, so the command below doesn't hold it.
exec 9>&-

# The machine's clock. Every machine shares the kernel's one real clock, so
# a machine that needs a time of day of its own (the identity-lab base's
# clock labs: the topology runs timesync on it, which gives it its own
# /etc/faketimerc) gets libfaketime: every program started here reads the
# real time moved by the seconds that file holds, read again every second.
# It works on programs that ask the C library for the time (Apache, curl,
# openssl, date, the shell's sleep), not on Go programs, and it breaks
# Python's time.sleep (the identity-lab base's README, "Clocks"). A machine
# without the file, or an image without the library, is left exactly as it
# was: that is every lab on this base alone.
#
# A program that must read the real time even there (the identity base's
# time sync, which is what sets the machine's clock) is started with
# NETLAB_REAL_CLOCK=1 and gets no libfaketime at all.
faketime=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1
unset FAKETIME_SHARED
if [[ -n ${NETLAB_REAL_CLOCK:-} ]]; then unset LD_PRELOAD; fi
if [[ -e /etc/netns/$m/faketimerc && -e $faketime && -z ${NETLAB_REAL_CLOCK:-} ]]; then
  # libfaketime 0.9.10 would also keep a semaphore and a shared-memory file
  # in /dev/shm for every command, name them in FAKETIME_SHARED (unset
  # above, in case this was started from a program that had one) and stop
  # any program that can neither open them nor make its own. On GitHub's
  # runner that stopped every command on such a machine. A fixed offset
  # doesn't need them, so the identity base's faketime-noshm, loaded just
  # before the library, makes it do without (its source says how).
  noshm=/usr/local/lib/idlab/faketime-noshm.so
  if [[ -e $noshm ]]; then
    export LD_PRELOAD="$noshm $faketime"
  else
    export LD_PRELOAD=$faketime
  fi
  export FAKETIME_CACHE_DURATION=1 DONT_FAKE_MONOTONIC=1 FAKETIME_DONT_FAKE_MONOTONIC=1
fi

# The machine's name, in a namespace of its own (the prompt reads root@r1),
# and no domain name: given the container's, FRR would write a "domainname"
# line into every configuration it saves.
exec unshare --uts /bin/sh -c 'hostname "$0" && domainname "(none)" && exec "$@"' "$m" "$@"

# Builds the lab's network at boot (/usr/local/lib/netlab/netlab up, from
# /etc/netlab/topology and each machine's own sysctl.d and network file):
# the machines, their cables and switches, their addresses and settings.
# Part of the lab's scenery, as a cloud's network is. Every machine's
# services are PartOf it, so stopping it stops them first, and
# "sudo netlab restart" rebuilds the whole network as a reboot would.
[Unit]
Description=The lab's network: its machines, cables and switches
DefaultDependencies=no
After=local-fs.target
Before=network.target multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/netlab/netlab up
ExecStop=/usr/local/lib/netlab/netlab down

[Install]
WantedBy=multi-user.target

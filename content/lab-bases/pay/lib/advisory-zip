#!/usr/bin/python3
"""advisory-zip FOLDER ZIP: the scanner's offline database, made from the
frozen advisory records in FOLDER (UBUNTU-CVE-*.json).

Run once, when the image is built. OSV-Scanner's offline mode reads
$OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY/osv-scalibr/Ubuntu/all.zip, any zip
of OSV records. The same records always give the same zip, byte for byte
(names sorted, one fixed date), so its checksum can be sealed.

One change is made on the way in. The records name their release
"Ubuntu:24.04:LTS"; OSV-Scanner 2.7.0 reads a package list as
"Ubuntu:24.04" and, offline, matches the two only when they are equal (it
found nothing in the records as published; 2.7.1 matches them). So the
zip's copy of each record says "Ubuntu:24.04". The files in FOLDER stay as
published. A base pinned to a scanner that matches the published form can
drop SHORTEN. Its cases are in tools/tests/test_pay_helpers.py.
"""

import glob
import os
import sys
import zipfile

SHORTEN = ('"Ubuntu:24.04:LTS"', '"Ubuntu:24.04"')
FIXED_DATE = (1980, 1, 1, 0, 0, 0)


def database(records: dict[str, str]) -> list[tuple[str, str]]:
    """(name in the zip, text) for each record, sorted by name."""
    return [(name, records[name].replace(*SHORTEN)) for name in sorted(records)]


def write_zip(path: str, entries: list[tuple[str, str]]) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with zipfile.ZipFile(path, "w") as archive:
        for name, text in entries:
            info = zipfile.ZipInfo(name, date_time=FIXED_DATE)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o644 << 16
            archive.writestr(info, text.encode("utf-8"))


def main() -> None:
    if len(sys.argv) != 3:
        print("usage: advisory-zip FOLDER ZIP", file=sys.stderr)
        sys.exit(2)
    records = {}
    for path in glob.glob(os.path.join(sys.argv[1], "UBUNTU-CVE-*.json")):
        with open(path, encoding="utf-8") as file:
            records[os.path.basename(path)] = file.read()
    if not records:
        print(f"advisory-zip: no records in {sys.argv[1]}", file=sys.stderr)
        sys.exit(1)
    write_zip(sys.argv[2], database(records))
    print(f"{sys.argv[2]}: {len(records)} records")


if __name__ == "__main__":
    main()

#!/usr/bin/python3
"""seal-range NAMESPACE KEY, or seal-range --file FILE KEY: is a journal
sealed, and for which time range does the verification key vouch?

For checks. It verifies one journal file with the verification key
(journalctl --verify --verify-key=KEY --file=...): the newest file of the
journal namespace, or the file named. One line comes back:

    sealed 2026-11-23T00:02:49Z 2026-11-23T00:03:00Z
        the file verifies, and the key validates this range (UTC); entries
        after the second time are not sealed yet
    unsealed
        the file verifies, but no range is validated: nothing in it proves
        who wrote it (a file written without the sealing key says this)
    failed: MESSAGE
        the file doesn't verify (changed bytes, the wrong key, no key), or
        there is no file

It always exits 0, so a check reads the line. Its cases are in
tools/tests/test_pay_helpers.py.
"""

import glob
import os
import re
import subprocess
import sys

VALIDATED = re.compile(
    r"Validated from \S+ (\d{4}-\d\d-\d\d) (\d\d:\d\d:\d\d) UTC"
    r" to \S+ (\d{4}-\d\d-\d\d) (\d\d:\d\d:\d\d) UTC"
)
OFFSET = re.compile(r"^[0-9a-f]+: ")


def verdict(output: str, code: int) -> str:
    """What journalctl --verify said about one file (its output, with times
    printed in UTC, and its exit status), as seal-range's one line."""
    lines = [line.strip() for line in output.splitlines() if line.strip()]
    failed = code != 0 or any(line.startswith("FAIL:") for line in lines)
    if failed:
        for line in lines:
            if line.startswith(("PASS:", "FAIL:", "File corruption detected", "=>")):
                continue
            return "failed: " + OFFSET.sub("", line)
        for line in lines:
            reason = re.search(r"^FAIL: .*\((.*)\)$", line)
            if reason:
                return "failed: " + reason.group(1)
        return "failed: journalctl --verify stopped without saying why"
    for line in lines:
        validated = VALIDATED.search(line)
        if validated:
            start_day, start, end_day, end = validated.groups()
            return f"sealed {start_day}T{start}Z {end_day}T{end}Z"
    if any(line.startswith("PASS:") for line in lines):
        return "unsealed"
    return "failed: journalctl --verify said nothing"


def newest_file(namespace: str, machine_id: str, roots=("/var/log/journal", "/run/log/journal")) -> str | None:
    """The journal file a namespace is writing now (system.journal), or its
    newest file when there is none; on disk before in memory."""
    for root in roots:
        folder = os.path.join(root, f"{machine_id}.{namespace}")
        live = os.path.join(folder, "system.journal")
        if os.path.exists(live):
            return live
        older = glob.glob(os.path.join(folder, "*.journal*"))
        if older:
            return max(older, key=os.path.getmtime)
    return None


def main() -> None:
    args = sys.argv[1:]
    if len(args) == 3 and args[0] == "--file":
        path, key = args[1], args[2]
    elif len(args) == 2:
        with open("/etc/machine-id", encoding="ascii") as file:
            machine_id = file.read().strip()
        path, key = newest_file(args[0], machine_id), args[1]
        if path is None:
            print(f"failed: the {args[0]} journal namespace has no files")
            return
    else:
        print("usage: seal-range NAMESPACE KEY | seal-range --file FILE KEY", file=sys.stderr)
        sys.exit(2)
    if not key.strip():
        print("failed: no verification key was given")
        return
    if not os.path.exists(path):
        print(f"failed: no such file: {path}")
        return
    run = subprocess.run(
        ["journalctl", "--verify", f"--verify-key={key.strip()}", f"--file={path}"],
        capture_output=True,
        text=True,
        errors="replace",
        env={**os.environ, "TZ": "UTC", "LC_ALL": "C"},
    )
    print(verdict(run.stdout + "\n" + run.stderr, run.returncode))


if __name__ == "__main__":
    main()

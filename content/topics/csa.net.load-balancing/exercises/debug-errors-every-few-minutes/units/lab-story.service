# The lab's story at every boot: the shop as the colleague who looked after
# the balancer left it.
[Unit]
Description=The shop as the balancer's last keeper left it
After=haproxy@lb.service
Wants=haproxy@lb.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/lab/story.sh

[Install]
WantedBy=multi-user.target

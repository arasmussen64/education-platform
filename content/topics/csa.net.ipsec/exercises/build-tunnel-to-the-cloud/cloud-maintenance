#!/bin/bash
# Usage: cloud-maintenance
# The provider's maintenance, on demand: its VPN gateway restarts, as a
# cloud's does when it updates a tunnel endpoint. Its strongSwan stops
# (closing the tunnel, and telling your gateway so) and starts again a
# moment later, ready to answer. Nothing of the provider's configuration
# changes. Whether the tunnel comes back is up to your gateway.
set -euo pipefail
sudo systemctl restart strongswan@cloud
echo "the provider's VPN gateway has restarted"

#!/bin/sh
# A vmstat whose numbers never change, for the checker. The real vmstat
# reads the whole machine, not the container, so on a busy host the blocked
# column (b) isn't the 0 it is on a quiet laptop, and a report that prints
# it instead of the run queue (r) could pass the check by luck. With these
# numbers, the first column of the last line is the only 7.
cat <<'EOF'
procs -----------memory---------- ---swap-- -----io---- -system-- -------cpu-------
 r  b   swpd   free   buff  cache   si   so    bi    bo   in   cs us sy id wa st gu
 2  0      0 812340  41020 503212    0    0    15     4  120  210  3  1 96  0  0  0
 7  3      0 812336  41020 503212    0    0     0     0  130  220 99  1  0  0  0  0
EOF

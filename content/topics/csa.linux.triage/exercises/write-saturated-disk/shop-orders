#!/usr/bin/python3
# shop-orders: the lab's stand-in for the service that takes the shop's
# orders. Part of the lab's scenery. An order is four 4 KiB writes in
# ORDERS_DIR (the order, the stock, the payment, the receipt), straight to
# the disk (O_DIRECT), because the customer is told "paid" only once the
# order is really there. It answers on port 8080 of this machine:
# "curl -s localhost:8080/order" places a test order and says how long it
# took to save. The shop's website sends it an order every two seconds as
# well, and every order is logged. The setting comes from
# /etc/shop/orders.conf.
import mmap
import os
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BLOCK = 4096
SLOTS = 64  # each file keeps the last 64 orders
PARTS = ["orders", "stock", "payments", "receipts"]

orders_dir = os.environ.get("ORDERS_DIR", "/srv/data/orders")
os.makedirs(orders_dir, exist_ok=True)


def open_part(name: str) -> int:
    path = os.path.join(orders_dir, f"{name}.dat")
    flags = os.O_RDWR | os.O_CREAT
    try:
        return os.open(path, flags | os.O_DIRECT, 0o640)
    except OSError:
        # A filesystem that can't write straight to the disk.
        return os.open(path, flags, 0o640)


files = [open_part(name) for name in PARTS]
number = 0
lock = threading.Lock()


def save_order(source: str) -> str:
    """Saves one order and returns the line that says how long it took."""
    global number
    with lock:
        number += 1
        order = number
    # Direct writes need memory aligned to the disk's blocks; an anonymous
    # mmap is aligned to a whole page.
    block = mmap.mmap(-1, BLOCK)
    block.write(b"o" * BLOCK)
    started = time.monotonic()
    for file in files:
        os.pwrite(file, block, (order % SLOTS) * BLOCK)
    took = (time.monotonic() - started) * 1000
    line = f"order {order} saved in {took:.0f} ms"
    print(f"shop-orders: {line} ({source})", flush=True)
    return line


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        if self.path != "/order":
            self.send_error(404, "Only /order is here")
            return
        body = (save_order("test order") + "\n").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args: object) -> None:
        pass  # save_order logs every order already


def website() -> None:
    while True:
        time.sleep(2)
        save_order("website")


print(f"shop-orders: saving orders in {orders_dir}, listening on 127.0.0.1:8080", flush=True)
threading.Thread(target=website, daemon=True).start()
ThreadingHTTPServer(("127.0.0.1", 8080), Handler).serve_forever()

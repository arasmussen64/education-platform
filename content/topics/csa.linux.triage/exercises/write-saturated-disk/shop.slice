# Everything the shop runs on this server is inside this slice (a slice is
# systemd's group of services, with one control group around them all), so
# a setting made here holds all of it at once. Its one setting is the data
# disk's allowance, in shop.slice.d/data-disk.conf. The slice starts once
# the lab's disks are attached, because systemd finds a disk named in a
# setting when the slice starts.
[Unit]
Description=The shop: everything that shares the data disk's allowance
Requires=lab-disks.service
After=lab-disks.service

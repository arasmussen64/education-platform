#!/usr/bin/python3
"""shop-api: the shop's API (stand-in). Answers every request with one line.
Listens on port 8080, on the address in $BIND (0.0.0.0, every interface,
unless told otherwise)."""

import os
from http.server import BaseHTTPRequestHandler, HTTPServer

BODY = b"shop api ok\n"


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.answer()
        self.wfile.write(BODY)

    def do_HEAD(self):
        self.answer()

    def answer(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(BODY)))
        self.end_headers()


bind = os.environ.get("BIND", "0.0.0.0")
print(f"shop-api listening on {bind}:8080", flush=True)
HTTPServer((bind, 8080), Handler).serve_forever()

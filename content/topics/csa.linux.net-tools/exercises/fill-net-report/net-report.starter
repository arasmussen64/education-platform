#!/bin/bash
# Usage: net-report
# Where this server is on the network, what it offers, and whether the
# shop's API answers.
echo "address on eth1: $(ip -4 -br addr show eth1 | awk '{print $...}' | cut -d/ -f1)"
echo "default gateway: $(ip route | awk '/^.../ {print $3}')"
echo "listening tcp ports: $(ss ... | awk 'NR > 1 {n = split($4, a, ":"); print a[n]}' | sort -un | paste -sd' ')"
echo "shop.internal resolves to: $(dig ... shop.internal)"
echo "shop-api answers: $(curl -s -o /dev/null -w '%{...}' http://shop.internal:8080/)"

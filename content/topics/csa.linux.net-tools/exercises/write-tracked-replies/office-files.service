# The office's file server, on the far side of eth1: a program run inside
# the office's network namespace, so from this machine a download is a
# connection out through eth1 to 10.0.9.2:8000. Part of the lab's scenery.
[Unit]
Description=office-files: the office's file server (in the office)
After=lab-network.service
Requires=lab-network.service

[Service]
NetworkNamespacePath=/run/netns/office
ExecStart=/usr/local/bin/office-files
Restart=on-failure

[Install]
WantedBy=multi-user.target

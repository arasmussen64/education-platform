# The office's monitoring endpoint, on the far side of eth1: a program run
# inside the office's network namespace, so from this machine it's a
# connection out through eth1 to 10.0.9.2:9100. Part of the lab's scenery.
[Unit]
Description=office-monitor: the office's monitoring endpoint (in the office)
After=lab-network.service
Requires=lab-network.service

[Service]
NetworkNamespacePath=/run/netns/office
ExecStart=/usr/local/bin/office-monitor
Restart=on-failure

[Install]
WantedBy=multi-user.target

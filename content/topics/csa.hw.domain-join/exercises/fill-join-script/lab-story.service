# Puts this machine in the state the walkthrough starts from, once, at the
# lab's first boot, after dc1 is up: the domain's names already forwarded.
# Part of the scenery.
[Unit]
Description=The lab's story so far
After=lab-dc.service dnsmasq.service
Requires=lab-dc.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStart=/usr/local/lib/lab/story.sh

[Install]
WantedBy=multi-user.target

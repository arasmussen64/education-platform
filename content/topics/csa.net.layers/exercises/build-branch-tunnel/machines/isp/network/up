# isp's network settings, run at every boot: the branch's ISP, which is
# also the rest of the internet as far as this lab goes.
ip addr add 198.51.100.5/30 dev line
ip addr add 203.0.113.1/24 dev core
# Anyone on the internet can send r3 packets addressed to the branch's own
# network; this route stands for them.
ip route add 10.0.5.0/24 via 198.51.100.6

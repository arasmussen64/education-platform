#!/usr/bin/python3
"""shop-debug: a debugging endpoint someone left listening on every
interface, port 9000. The kind of forgotten door a hardening pass finds and
closes. Answers nothing useful; it just shouldn't be open to the world."""

import socket

server = socket.socket()
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(("0.0.0.0", 9000))
server.listen(8)
print("shop-debug listening on 0.0.0.0:9000", flush=True)
while True:
    connection, _ = server.accept()
    connection.close()

# Makes the lab's network at boot (see /usr/local/lib/lab/network.sh): the
# office on the far side of eth1. Part of the lab's scenery.
[Unit]
Description=The lab's network: the office on the far side of eth1
DefaultDependencies=no
After=local-fs.target
Before=network.target multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/lab/network.sh

[Install]
WantedBy=multi-user.target

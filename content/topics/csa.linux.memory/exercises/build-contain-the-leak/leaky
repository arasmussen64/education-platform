#!/usr/bin/python3
"""leaky [CAP_MB]: a program with a memory leak. It grows by 32 MB a second
until it reaches CAP_MB (600 by default), then keeps what it has. A stand-in
for the shop's indexer, which forgets to let go of what it has read."""

import sys
import time

cap = int(sys.argv[1]) if len(sys.argv) > 1 else 600
chunks = []
while len(chunks) < cap:
    chunk = bytearray(1024 * 1024)
    for i in range(0, len(chunk), 4096):
        chunk[i] = 1
    chunks.append(chunk)
    if len(chunks) % 32 == 0:
        time.sleep(1)
while True:
    time.sleep(3600)

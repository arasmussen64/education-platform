#!/usr/bin/python3
"""shop-cache: the shop's in-memory cache (stand-in). It needs about 100 MB
to hold its working set, and then serves, forever."""

import time

data = bytearray(100 * 1024 * 1024)
for i in range(0, len(data), 4096):
    data[i] = 1
print("cache warm: 100 MB")
while True:
    time.sleep(3600)

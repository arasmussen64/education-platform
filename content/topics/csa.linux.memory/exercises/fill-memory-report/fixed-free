#!/bin/sh
# A free whose numbers never change, for the checker. The real free reads
# the whole machine, not the container, and on a machine with no swap at
# all the total and the used column are both 0, so a report that prints
# the total could pass the check by luck (two CI runs did, on 2026-11-15,
# on machines with no swap). With these numbers, 300 is in the used column
# of the Swap line and nowhere else.
cat <<'EOF'
               total        used        free      shared  buff/cache   available
Mem:            7812        1403        4012          12        2687        6409
Swap:           2047         300        1747
EOF

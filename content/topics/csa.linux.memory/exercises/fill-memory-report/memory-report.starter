#!/bin/bash
# Says how this machine's memory is doing, in four lines.
available_kb=$(grep '^...:' /proc/meminfo | awk '{print $2}')
echo "available: $((available_kb / 1024)) MB"
echo "swap used: $(free -m | awk '/^Swap:/ {print $...}') MB"
echo "top process: $(ps -eo comm,rss --sort=... | awk 'NR == 2 {print $1, int($2 / 1024) " MB"}')"
echo "oom kills: $(journalctl -k --no-pager 2>/dev/null | grep -c '...')"

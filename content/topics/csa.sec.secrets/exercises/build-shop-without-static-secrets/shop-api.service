# The shop's order API (scenery): /usr/local/bin/shop-api on
# 127.0.0.1:8080, as the user shop, from boot. Which credentials file it
# reads is set in /etc/shop/shop-api.conf.
[Unit]
Description=The shop's order API
After=postgresql.service

[Service]
User=shop
ExecStart=/usr/local/bin/shop-api
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

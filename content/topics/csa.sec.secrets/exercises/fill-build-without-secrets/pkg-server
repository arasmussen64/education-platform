#!/usr/bin/env python3
"""pkg-server: the shop's package server, as far as this lab goes.

It listens on 127.0.0.1:8081 and hands out one file, /shop-lib.txt, to a
request that carries "Authorization: Bearer TOKEN" with the token in
/var/lib/pkg-server/token. Any other request gets 401. The library it
serves is the one line in /var/lib/pkg-server/library. Both files are
read again for every request. Scenery: don't change it.
"""

import http.server

STATE = "/var/lib/pkg-server"


def read(name: str) -> str:
    with open(f"{STATE}/{name}", encoding="utf-8") as file:
        return file.read().strip()


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        allowed = self.headers.get("Authorization") == f"Bearer {read('token')}"
        if allowed and self.path == "/shop-lib.txt":
            status, body = 200, (read("library") + "\n").encode()
        elif allowed:
            status, body = 404, b"no such package\n"
        else:
            status, body = 401, b"a token is needed\n"
        self.send_response(status)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args: object) -> None:
        # Quiet: the journal isn't part of this lab.
        pass


if __name__ == "__main__":
    http.server.HTTPServer(("127.0.0.1", 8081), Handler).serve_forever()

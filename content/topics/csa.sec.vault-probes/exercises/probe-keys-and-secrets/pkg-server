#!/usr/bin/env python3
"""pkg-server: the shop's package server, as far as this lab goes.

It listens on 127.0.0.1:8099 and hands out one file, /shop-lib.txt, to a
request that carries "Authorization: Bearer TOKEN" with the token in
/etc/shop/pkg.token. Any other request gets 401. Scenery: don't change it.
"""

import http.server

TOKEN_FILE = "/etc/shop/pkg.token"
LIBRARY = b"shop-lib 2.4.1\n"


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        with open(TOKEN_FILE, encoding="utf-8") as file:
            token = file.read().strip()
        allowed = self.headers.get("Authorization") == f"Bearer {token}"
        if allowed and self.path == "/shop-lib.txt":
            status, body = 200, LIBRARY
        elif allowed:
            status, body = 404, b"no such package\n"
        else:
            status, body = 401, b"a token is needed\n"
        self.send_response(status)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args: object) -> None:
        # Quiet: the journal isn't part of this lab.
        pass


if __name__ == "__main__":
    http.server.HTTPServer(("127.0.0.1", 8099), Handler).serve_forever()

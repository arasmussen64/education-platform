# The partners' API on web: api.shop.test on port 8443, for the shop's
# partners only, each of which proves who it is with a client certificate.
server {
    listen 8443 ssl;
    server_name api.shop.test;
    ssl_certificate     /etc/nginx/tls/___;
    ssl_certificate_key /etc/nginx/tls/api.key;
    ssl_client_certificate /etc/nginx/tls/___;
    ssl_verify_client ___;
    root /srv/www/api;
}

# The shop's sites on web: www.shop.test, the public shop, on 443, and
# api.shop.test, the partners' API, on 8443.

# Plain HTTP: ACME's challenge files, and the shop sent to HTTPS.
server {
    listen 80;
    server_name www.shop.test;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name www.shop.test;
    ssl_certificate     /etc/nginx/certs/www.pem;
    ssl_certificate_key /etc/nginx/certs/www.key;
    root /srv/www/www;
}

server {
    listen 8443 ssl http2;
    server_name api.shop.test;
    ssl_certificate     /etc/nginx/tls/api.shop.test/cert.pem;
    ssl_certificate_key /etc/nginx/tls/api.shop.test/privkey.pem;
    ssl_client_certificate /etc/ssl/certs/ca-certificates.crt;
    ssl_verify_client on;
    root /srv/www/api;
}

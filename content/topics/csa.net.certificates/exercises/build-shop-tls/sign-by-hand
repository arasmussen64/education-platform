#!/bin/bash
# sign-by-hand NAME HOURS CERT KEY: a certificate for NAME, good for HOURS,
# signed with the shop CA's intermediate key directly, without ACME, as an
# administrator holding that key can: what "made by hand" means in these
# labs. CERT gets the certificate followed by the intermediate's (the full
# chain), KEY its private key. Like every certificate step-ca issues, it is
# for servers and for clients both (serverAuth and clientAuth).
set -euo pipefail
s=/var/lib/step-ca
step certificate create "$1" "$3" "$4" --profile leaf --san "$1" --not-after "${2}h" \
  --ca "$s/certs/intermediate_ca.crt" --ca-key "$s/secrets/intermediate_ca_key" \
  --ca-password-file "$s/secrets/password" --bundle --no-password --insecure -f > /dev/null 2>&1

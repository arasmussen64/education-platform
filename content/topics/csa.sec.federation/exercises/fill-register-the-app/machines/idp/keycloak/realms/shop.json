{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "all",
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "groups": [{ "name": "staff" }, { "name": "warehouse" }],
  "users": [
    {
      "id": "0a000000-0000-4000-8000-000000000001",
      "username": "ana",
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Lima",
      "email": "ana@shop.test",
      "emailVerified": true,
      "groups": ["/staff"],
      "credentials": [{ "type": "password", "value": "${ANA_PASSWORD}", "temporary": false }]
    },
    {
      "id": "0a000000-0000-4000-8000-000000000002",
      "username": "ben",
      "enabled": true,
      "firstName": "Ben",
      "lastName": "Okoro",
      "email": "ben@shop.test",
      "emailVerified": true,
      "groups": ["/warehouse"],
      "credentials": [{ "type": "password", "value": "${BEN_PASSWORD}", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "orders-web",
      "name": "The new orders site",
      "enabled": true,
      "publicClient": false,
      "secret": "${ORDERS_WEB_SECRET}",
      "standardFlowEnabled": "...",
      "implicitFlowEnabled": "...",
      "directAccessGrantsEnabled": "...",
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["..."],
      "attributes": {
        "pkce.code.challenge.method": "...",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "multivalued": "true",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}

#!/usr/bin/env python3
"""resign-token: the checks' tool, never the learner's (root only, mode 700).

  resign-token [--key NAME] [--set CLAIM=JSON]... [--drop CLAIM]... < token

Reads a token the identity provider issued, changes the claims named, and
signs the result again with one of the shop realm's own signing keys (the
private key in /etc/keycloak/keys/shop/ on idp; NAME is 2026 unless given).
The new token is one the provider could have issued and never did: for an
audience made up as the check runs, already expired, or signed with last
year's key. An API that checks a token properly refuses or serves each as
it would the real thing, and no real client could be made to ask for one.

Every token gets a new "jti" (its serial number), so the API has never
seen it. A value starting "now" is a time: now, now+300, now-300.

It runs as root on the lab machine, whose clock is the real one.
"""

import argparse
import base64
import hashlib
import json
import secrets
import sys
import time

from cryptography import x509
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import padding

KEYS = "/etc/netns/idp/keycloak/keys/shop"


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def unb64url(text):
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def kid_of(certificate_file):
    """The name Keycloak gives a key: the SHA-256 of the public key."""
    certificate = x509.load_pem_x509_certificate(open(certificate_file, "rb").read())
    der = certificate.public_key().public_bytes(
        serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo
    )
    return b64url(hashlib.sha256(der).digest())


def value_of(text, now):
    if text.startswith("now"):
        return now + int(text[3:] or 0)
    return json.loads(text)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--key", default="2026")
    parser.add_argument("--set", action="append", default=[])
    parser.add_argument("--drop", action="append", default=[])
    args = parser.parse_args()

    pieces = sys.stdin.read().strip().split(".")
    if len(pieces) != 3:
        sys.exit("resign-token: standard input isn't a token")
    header = json.loads(unb64url(pieces[0]))
    payload = json.loads(unb64url(pieces[1]))
    now = int(time.time())
    payload["jti"] = secrets.token_hex(16)
    for item in args.set:
        claim, _, text = item.partition("=")
        payload[claim] = value_of(text, now)
    for claim in args.drop:
        payload.pop(claim, None)
    header["kid"] = kid_of(f"{KEYS}/{args.key}.crt")
    header["alg"] = "RS256"
    signed = (
        b64url(json.dumps(header).encode()) + "." + b64url(json.dumps(payload).encode())
    )
    key = serialization.load_pem_private_key(
        open(f"{KEYS}/{args.key}.key", "rb").read(), None
    )
    print(
        signed
        + "."
        + b64url(key.sign(signed.encode(), padding.PKCS1v15(), hashes.SHA256()))
    )


if __name__ == "__main__":
    main()

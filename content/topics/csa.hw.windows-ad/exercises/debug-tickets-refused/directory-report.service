# The nightly directory report: the members of the shop's groups, written
# to /srv/reports/groups.txt. Its timer starts it at two every night.
[Unit]
Description=The nightly directory report
After=dnsmasq.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/directory-report linux-admins stock-team
StandardOutput=truncate:/srv/reports/groups.txt
StandardError=journal

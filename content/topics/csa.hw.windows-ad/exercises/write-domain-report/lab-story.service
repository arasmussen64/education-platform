# Puts the lab in the state the exercise starts from, once, at its first
# boot, after dc1 is up. Part of the scenery.
[Unit]
Description=The lab's story so far
After=lab-dc.service dnsmasq.service
Requires=lab-dc.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStart=/usr/local/lib/lab/story.sh

[Install]
WantedBy=multi-user.target

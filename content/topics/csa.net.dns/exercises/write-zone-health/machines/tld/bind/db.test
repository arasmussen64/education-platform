; The top-level domain test. Names without a final dot end in .test.
$TTL 3600
@                IN SOA ns1.nic.test. hostmaster.nic.test. ( 2026111201 1800 900 604800 3600 ) ; serial
@                IN NS  ns1.nic
ns1.nic          IN A   198.51.100.12
a.root-servers   IN A   198.51.100.11
; shop.test is delegated to the shop's two servers, with glue
shop             IN NS  ns1.shop
shop             IN NS  ns2.shop
ns1.shop         IN A   198.51.100.13
ns2.shop         IN A   198.51.100.14
; Two zones the checks bring up servers for, at 198.51.100.16 to .18
check-a          IN NS  north.check-a
check-a          IN NS  east.check-a
check-a          IN NS  west.check-a
north.check-a    IN A   198.51.100.16
east.check-a     IN A   198.51.100.17
west.check-a     IN A   198.51.100.18
check-b          IN NS  one.check-b
check-b          IN NS  two.check-b
check-b          IN NS  three.check-b
one.check-b      IN A   198.51.100.18
two.check-b      IN A   198.51.100.17
three.check-b    IN A   198.51.100.16

// The shop's zone. ns1 is its primary: the zone file here is the master
// copy, and ns2, the secondary, copies the zone from here. Only ns2 may
// copy it (allow-transfer), and ns2 is told at once when it changes
// (also-notify).
zone "shop.test" {
  type primary;
  file "/etc/bind/db.shop.test";
  allow-transfer { 198.51.100.14; };
  also-notify { 198.51.100.14; };
};

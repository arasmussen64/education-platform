// An authoritative-only name server: it answers for its own zones and
// never looks anything up for anyone else (recursion no), so strangers
// can't use it as a resolver.
options {
  directory "/var/cache/bind";
  recursion no;
  allow-query { any; };
  allow-transfer { none; };
  listen-on { any; };
  listen-on-v6 { none; };
  dnssec-validation no;
  // The lab's fast clock: a copy that fails (ns1 not answering yet at
  // boot) is tried again within 10 seconds. BIND's default waits at least
  // 500 seconds (min-retry-time), and a real secondary may.
  min-retry-time 5;
  max-retry-time 10;
};

# Puts the lab in the state the exercise starts from, once, at its first
# boot, after the name servers are up. Part of the scenery.
[Unit]
Description=The lab's story so far
After=netlab.service named@ns1.service named@ns2.service
Requires=netlab.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=240
ExecStart=/usr/local/lib/lab/story.sh

[Install]
WantedBy=multi-user.target

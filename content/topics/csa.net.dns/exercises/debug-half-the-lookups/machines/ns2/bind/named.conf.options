// An authoritative-only name server: it answers for its own zones and
// never looks anything up for anyone else (recursion no), so strangers
// can't use it as a resolver.
options {
  directory "/var/cache/bind";
  recursion no;
  allow-query { any; };
  allow-transfer { none; };
  listen-on { any; };
  listen-on-v6 { none; };
  dnssec-validation no;
};

// The root zone. BIND signs it itself, with its default DNSSEC policy: the
// key is in /etc/bind/keys, and the signed copy is written beside the zone
// file (db.root.signed). Edit db.root, never the signed copy.
zone "." {
  type primary;
  file "/etc/bind/db.root";
  dnssec-policy default;
  inline-signing yes;
  key-directory "/etc/bind/keys";
};

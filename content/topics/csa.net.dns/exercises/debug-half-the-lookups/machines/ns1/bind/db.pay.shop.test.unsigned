; The payments site's zone, pay.shop.test, as written by hand. It is
; signed by hand too: dnssec-signzone signs this file with the zone's key
; in /etc/bind/keys and writes db.pay.shop.test, the signed copy BIND
; serves. The team's steps, after any change here (and the serial raised):
;   cd /etc/bind
;   dnssec-signzone -S -K keys -z -o pay.shop.test -f db.pay.shop.test db.pay.shop.test.unsigned
;   rndc reload pay.shop.test
; -S adds the zone's keys from /etc/bind/keys, -z lets its one key sign
; everything, -o names the zone and -f the file written. Signatures last
; 30 days unless -e says otherwise.
$TTL 300
@        IN SOA ns1.shop.test. hostmaster.shop.test. ( 2026111201 3600 600 1209600 300 ) ; serial
@        IN NS    ns1.shop.test.
@        IN A     203.0.113.60
www      IN A     203.0.113.60

// The European site's zone, eu.shop.test, which ns-eu serves alone. BIND
// signs it with a DNSSEC policy, making its key in /etc/bind/keys at its
// first start, and writes the signed copy beside the zone file. Fill in
// each ...
zone "eu.shop.test" {
  type primary;
  file "...";
  dnssec-policy ...;
  inline-signing yes;
  key-directory "/etc/bind/keys";
};

// The shop's zone, copied from ns1 (its primary) by zone transfer. ns2
// asks ns1 for the zone's SOA every refresh interval, and when ns1 tells it
// the zone changed (a NOTIFY), and copies the zone whenever ns1's serial is
// higher than its own. It keeps the copy in /var/cache/bind.
zone "shop.test" {
  type secondary;
  primaries { 198.51.100.13; };
  file "/var/cache/bind/db.shop.test";
};

  "authenticationFlows": [
    {
      "alias": "shop-browser",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "shop-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "shop-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "authenticatorConfig": "pwd-ref"
        },
        {
          "flowAlias": "admins use a security key",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true
        },
        {
          "flowAlias": "others use a code",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "admins use a security key",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "authenticatorConfig": "is-admin"
        },
        {
          "authenticator": "webauthn-authenticator",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "authenticatorConfig": "hwk-ref"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "others use a code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "authenticatorConfig": "not-admin"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "authenticatorConfig": "otp-ref"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "is-admin",
      "config": {
        "condUserRole": "admin"
      }
    },
    {
      "alias": "not-admin",
      "config": {
        "condUserRole": "admin",
        "negate": "true"
      }
    },
    {
      "alias": "pwd-ref",
      "config": {
        "default.reference.value": "pwd"
      }
    },
    {
      "alias": "hwk-ref",
      "config": {
        "default.reference.value": "hwk"
      }
    },
    {
      "alias": "otp-ref",
      "config": {
        "default.reference.value": "otp"
      }
    }
  ],
  "browserFlow": "shop-browser",
  "clients": [
    {
      "clientId": "trace-cli",
      "name": "A command-line tool",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8400/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "payments",
      "name": "The payments app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8401/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "admin-app",
      "name": "The admin console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8402/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": false
    }
  ],
  "bruteForceProtected": true,
  "failureFactor": 5
}
{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "all",
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "roles": { "realm": [{ "name": "admin" }] },
  "groups": [
    { "name": "staff" },
    { "name": "admins", "realmRoles": ["admin"] }
  ],
  "users": [
    {
      "id": "0a000000-0000-4000-8000-000000000031",
      "username": "alice",
      "enabled": true, "firstName": "Alice", "lastName": "Ng",
      "email": "alice@shop.test", "emailVerified": true,
      "groups": ["/admins"],
      "credentials": [
        { "type": "password", "value": "${ALICE_PASSWORD}", "temporary": false },
        { "type": "webauthn", "userLabel": "alice's key", "credentialData": "${ALICE_KEY}", "secretData": "{}" }
      ]
    },
    {
      "id": "0a000000-0000-4000-8000-000000000032",
      "username": "ana",
      "enabled": true, "firstName": "Ana", "lastName": "Lima",
      "email": "ana@shop.test", "emailVerified": true,
      "groups": ["/staff"],
      "credentials": [
        { "type": "password", "value": "${ANA_PASSWORD}", "temporary": false },
        { "type": "otp", "userLabel": "ana's app", "secretData": "{\"value\":\"${ANA_OTP}\"}", "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}" }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "shop-browser", "providerId": "basic-flow", "topLevel": true, "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "autheticatorFlow": false },
        { "flowAlias": "shop-forms", "requirement": "ALTERNATIVE", "priority": 20, "autheticatorFlow": true }
      ]
    },
    {
      "alias": "shop-forms", "providerId": "basic-flow", "topLevel": false, "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "authenticatorConfig": "pwd-ref" },
        { "flowAlias": "admins use a security key", "requirement": "CONDITIONAL", "priority": 20, "autheticatorFlow": true },
        { "flowAlias": "others use a code", "requirement": "CONDITIONAL", "priority": 30, "autheticatorFlow": true }
      ]
    },
    {
      "alias": "admins use a security key", "providerId": "basic-flow", "topLevel": false, "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "authenticatorConfig": "is-admin" },
        { "authenticator": "webauthn-authenticator", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "authenticatorConfig": "hwk-ref" }
      ]
    },
    {
      "alias": "others use a code", "providerId": "basic-flow", "topLevel": false, "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "authenticatorConfig": "not-admin" },
        { "authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "authenticatorConfig": "otp-ref" }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "is-admin", "config": { "condUserRole": "admin" } },
    { "alias": "not-admin", "config": { "condUserRole": "admin", "negate": "true" } },
    { "alias": "pwd-ref", "config": { "default.reference.value": "pwd" } },
    { "alias": "hwk-ref", "config": { "default.reference.value": "hwk" } },
    { "alias": "otp-ref", "config": { "default.reference.value": "otp" } }
  ],
  "browserFlow": "shop-browser",
  "clients": [
    {
      "clientId": "trace-cli", "name": "A command-line tool", "enabled": true,
      "publicClient": true, "standardFlowEnabled": true, "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8400/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        { "name": "amr", "protocol": "openid-connect", "protocolMapper": "oidc-amr-mapper",
          "config": { "id.token.claim": "true", "access.token.claim": "true" } }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "admin-app", "name": "The admin console", "enabled": true,
      "publicClient": true, "standardFlowEnabled": true, "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8402/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" }, "fullScopeAllowed": false
    }
  ]
}

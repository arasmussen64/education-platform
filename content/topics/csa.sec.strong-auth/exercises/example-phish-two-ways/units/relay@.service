[Unit]
Description=The phishing relay on %i (lab scenery)
After=keycloak@idp.service
Wants=keycloak@idp.service

[Service]
ExecStart=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/local/bin/relay 443 /etc/tls/login.shop-help.test.crt /etc/tls/login.shop-help.test.key
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

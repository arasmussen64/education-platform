#!/bin/bash
# lb-announce: lb's failover software. Like the software in a real pair of
# load balancers, it announces the service address, 10.20.0.80, every 30
# seconds with a gratuitous ARP, so that every machine on the network sends
# the address's traffic to lb.
while true; do
  arping -q -U -c 1 -I eth0 10.20.0.80
  sleep 30
done

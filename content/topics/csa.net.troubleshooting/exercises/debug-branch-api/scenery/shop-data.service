# The shop's data service (/usr/local/bin/shop-data), on db, port 5000.
[Unit]
Description=The shop's data service, on db
After=netlab.service
Requires=netlab.service
PartOf=netlab.service

[Service]
SyslogIdentifier=shop-data
ExecStart=/usr/sbin/ip netns exec db /usr/local/lib/netlab/lab-enter db /usr/local/bin/shop-data
Restart=always

[Install]
WantedBy=multi-user.target

# The office's monitor of the shop (/usr/local/bin/shop-monitor), on pc.
[Unit]
Description=The office's monitor of the shop, on pc
After=netlab.service unbound@resolver.service
Requires=netlab.service
PartOf=netlab.service

[Service]
SyslogIdentifier=shop-monitor
ExecStart=/usr/sbin/ip netns exec pc /usr/local/lib/netlab/lab-enter pc /usr/local/bin/shop-monitor
Restart=always

[Install]
WantedBy=multi-user.target

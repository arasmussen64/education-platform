# app: the shop's web app (a stand-in), on port 8443. It answers with the
# address each connection came from, and logs it, as the real app's rate
# limiter would see it.
server {
    listen 8443 default_server;
    location / {
        default_type text/plain;
        return 200 "you are $remote_addr\n";
    }
}

# Which FRR daemons run on this router: zebra, which hands the chosen
# routes to the kernel, staticd, which holds static routes, bgpd, BGP, and
# bfdd, BFD, the quick check that a link still carries traffic.
zebra=yes
staticd=yes
bgpd=yes
bfdd=yes
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"

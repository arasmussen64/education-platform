[Unit]
Description=shop-api: the shop's web API
After=network-online.target
Wants=network-online.target

[Service]
# The account the service runs as. Never root.
User=...
WorkingDirectory=/srv/shop-api
Environment=PORT=8080
# The command, with the program's full path (which python3 tells you).
ExecStart=... /srv/shop-api/server.py
# Start it again when it exits with an error or crashes.
Restart=...
RestartSec=3

[Install]
# The target a normally booted server reaches.
WantedBy=...

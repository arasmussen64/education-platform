#!/usr/bin/env python3
"""order-board: the staff order board, a WebSocket server on port 8090 of
its machine's own loopback address (127.0.0.1), behind nginx's /board/.
"systemctl status order-board@origin".

A staff screen opens a WebSocket and sends a message; the board answers each
one ("order board: ..."). Between messages it sends nothing at all, except a
ping every ping_interval seconds, read from /etc/order-board/board.conf when
it starts: a screen that doesn't answer the ping with a pong is dropped. It
writes to its journal when it starts and when a screen comes and goes:
journalctl -u order-board@origin.
"""

import asyncio

import websockets

CONF = "/etc/order-board/board.conf"


def ping_interval():
    """ping_interval = N from the settings file; 0 or nothing means no pings."""
    seconds = 0
    with open(CONF) as conf:
        for line in conf:
            key, _, value = line.split("#")[0].partition("=")
            if key.strip() == "ping_interval":
                seconds = int(value.strip())
    return seconds or None


async def screen(websocket, path=None):
    print("a screen connected", flush=True)
    try:
        async for message in websocket:
            await websocket.send(f"order board: {message}")
    except websockets.exceptions.ConnectionClosed:
        # A screen that vanished without saying goodbye: nothing to answer.
        pass
    finally:
        print("a screen went away", flush=True)


async def main():
    interval = ping_interval()
    print(f"pinging every screen every {interval} seconds" if interval else "not pinging", flush=True)
    async with websockets.serve(screen, "127.0.0.1", 8090, ping_interval=interval, ping_timeout=20):
        await asyncio.Future()


asyncio.run(main())

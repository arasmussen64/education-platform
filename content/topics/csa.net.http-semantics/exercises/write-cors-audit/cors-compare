#!/bin/bash
# cors-compare URL ORIGIN METHOD HEADER CREDENTIALS: the checks' comparison
# (a check's tool, not the learner's). HEADER is "Name: value" or -, and
# CREDENTIALS yes or no. It sends the two requests a browser would send
# (the preflight and the request, whatever they are), asks cors-verdict, the
# network base's model of a browser, what a browser decides from those
# answers, then runs the learner's ~/bin/cors-audit, as the learner, on the
# same request. Prints "same", or both answers.
url=$1 origin=$2 method=$3 header=$4 cred=""
[ "$header" = - ] && header=""
[ "$5" = yes ] && cred=--credentials
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
ask=(-H "Origin: $origin" -H "Access-Control-Request-Method: $method")
[ -n "$header" ] && ask+=(-H "Access-Control-Request-Headers: $(echo "${header%%:*}" | tr '[:upper:]' '[:lower:]')")
curl -si --max-time 5 -X OPTIONS "${ask[@]}" "$url" > "$dir/pre" 2> /dev/null
send=(-X "$method" -H "Origin: $origin")
[ -n "$header" ] && send+=(-H "$header")
[ -n "$cred" ] && send+=(-H "Cookie: session=audit")
curl -si --max-time 5 "${send[@]}" "$url" > "$dir/act" 2> /dev/null
want=$(python3 /usr/local/lib/lab/cors-verdict "$dir/pre" "$dir/act" "$origin" "$method" ${header:+"$header"} $cred)
args=("$url" "$origin" "$method")
[ -n "$header" ] && args+=("$header")
[ -n "$cred" ] && args+=(--credentials)
got=$(cd /home/learner && runuser -u learner -- timeout 10 /home/learner/bin/cors-audit "${args[@]}" 2>&1 | head -n 3)
if [ "$got" = "$want" ]; then
  echo same
else
  echo "for $method${header:+ with \"$header\"} from $origin${cred:+ with the cookie}, a browser decides \"$want\", and the script printed \"${got:-nothing}\""
fi

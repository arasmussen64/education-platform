#!/usr/bin/env python3
"""shop-api [PORT]: a stand-in for the shop's basket API, with the CORS
answers the shop's nginx gives (port 8080 unless given), to try cors-audit
on. Started when the lab starts; the checks start one of their own too.

Pages from https://shop.test and https://www.shop.test may call it with the
customer's cookie, using GET, PUT and DELETE with a JSON body. A preflight
is answered 204; anything else gets the basket as JSON.
"""

import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ALLOWED = {"https://shop.test", "https://www.shop.test"}


class Basket(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "shop-api"
    sys_version = ""

    def cors(self):
        origin = self.headers.get("Origin", "")
        if origin in ALLOWED:
            self.send_header("Access-Control-Allow-Origin", origin)
        self.send_header("Access-Control-Allow-Credentials", "true")
        self.send_header("Vary", "Origin")

    def do_OPTIONS(self):
        self.send_response(204)
        self.cors()
        self.send_header("Access-Control-Allow-Methods", "GET, PUT, DELETE")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Max-Age", "600")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length:
            self.rfile.read(length)
        body = b'{"customer": "audit", "items": 3}\n'
        self.send_response(200)
        self.cors()
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    do_HEAD = do_POST = do_PUT = do_DELETE = do_PATCH = do_GET

    def log_message(self, format, *args):
        pass


class Quiet(ThreadingHTTPServer):
    def handle_error(self, request, client_address):
        pass  # a client that hung up early needs no traceback


port = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
Quiet(("127.0.0.1", port), Basket).serve_forever()

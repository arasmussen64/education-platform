# The edge cache, nginx on edge: www.shop.test, as customers reach the shop.
# A shared cache in front of the origin, as a CDN is: it keeps a copy of
# whatever the origin's headers let a shared cache keep, and says what it
# did in X-Cache-Status (MISS: fetched from the origin; HIT: answered from
# its own copy). Scenery: nobody at the shop runs it, as nobody runs their
# CDN's servers. sudo edge-purge empties it, as a CDN's purge button does.
proxy_cache_path /var/lib/nginx/edge-cache keys_zone=edge:10m max_size=100m inactive=1d use_temp_path=off;

server {
    listen 80 default_server;
    server_name www.shop.test shop.test;

    location / {
        proxy_pass http://10.0.9.1;
        proxy_set_header Host $host;
        proxy_cache edge;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # The order board's WebSockets pass straight through. Like the load
    # balancer in front of a real site, the edge drops a connection that
    # has carried nothing at all for 120 seconds.
    location /board/ {
        proxy_pass http://10.0.9.1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}

#!/usr/bin/env python3
"""shop-app: the shop's application, on port 8080 of its machine's own
loopback address (127.0.0.1), behind the machine's nginx.
"systemctl status shop-app@origin".

  /account      a customer's own account page, made for the session cookie
                the request carries (Cookie: session=NAME)
  /api/basket   the basket API: GET reads the customer's basket, PUT sets it
                from a JSON body ({"items": 3}), DELETE empties it

It sets no caching or CORS headers: nginx, in front of it, owns those. It
answers no preflights (OPTIONS gets 405 Method Not Allowed), and it writes
one line to its journal for every request it gets, method first:
journalctl -u shop-app@origin.
"""

import json
import time
from http.cookies import CookieError, SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

baskets = {}


def now():
    """The time to the millisecond, so two answers can be told apart."""
    t = time.time()
    return time.strftime("%H:%M:%S", time.localtime(t)) + f".{int(t * 1000) % 1000:03d}"


class Shop(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "shop-app"
    sys_version = ""

    def customer(self):
        try:
            cookie = SimpleCookie(self.headers.get("Cookie", ""))
        except CookieError:
            return None
        return cookie["session"].value if "session" in cookie else None

    def reply(self, status, body, kind="application/json", extra=()):
        data = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        for name, value in extra:
            self.send_header(name, value)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def log_request(self, code="-", size="-"):
        origin = self.headers.get("Origin", "-")
        print(f"{self.command} {self.path} {code} origin={origin}", flush=True)

    def log_message(self, format, *args):
        pass

    def basket(self, who):
        answer = {"customer": who, "items": baskets.get(who, 0), "at": now()}
        return json.dumps(answer) + "\n"

    def do_GET(self):
        who = self.customer()
        if self.path.startswith("/account"):
            if not who:
                return self.reply(401, "sign in first\n", "text/plain")
            page = f"account page for {who}, made at {now()}\n"
            return self.reply(200, page, "text/plain")
        if self.path.startswith("/api/basket"):
            if not who:
                return self.reply(401, '{"error": "sign in first"}\n')
            return self.reply(200, self.basket(who))
        self.reply(404, '{"error": "no such page"}\n')

    do_HEAD = do_GET

    def do_PUT(self):
        who = self.customer()
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b""
        if not self.path.startswith("/api/basket"):
            return self.reply(404, '{"error": "no such page"}\n')
        if not who:
            return self.reply(401, '{"error": "sign in first"}\n')
        try:
            baskets[who] = int(json.loads(body or b"{}").get("items", 0))
        except (ValueError, AttributeError):
            return self.reply(400, '{"error": "send JSON: {\\"items\\": 3}"}\n')
        self.reply(200, self.basket(who))

    def do_DELETE(self):
        who = self.customer()
        if not self.path.startswith("/api/basket"):
            return self.reply(404, '{"error": "no such page"}\n')
        if not who:
            return self.reply(401, '{"error": "sign in first"}\n')
        baskets.pop(who, None)
        self.reply(200, self.basket(who))

    def do_OPTIONS(self):
        self.reply(405, '{"error": "method not allowed"}\n', extra=[("Allow", "GET, PUT, DELETE")])


ThreadingHTTPServer(("127.0.0.1", 8080), Shop).serve_forever()

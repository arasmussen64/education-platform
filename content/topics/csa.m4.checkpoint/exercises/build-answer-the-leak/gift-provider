#!/usr/bin/python3
"""gift-provider: a stand-in for the gift-card company's API, on
127.0.0.1:9450. Scenery: the lab's outside company, not yours to change.

  POST /v1/cards?amount=N     issue a gift card, with a shop key as the bearer
  GET  /v1/whoami             which key the bearer is, and whether it works
  GET  /admin/keys            the shop's keys (the admin key as the bearer)
  POST /admin/keys            a new key: answers its id and the key, once
  POST /admin/keys/ID/revoke  revoke a key, for good

The shop may have several keys active at once, so a new key can be put in
place before the old one is revoked. The keys are kept in
/var/lib/gift-provider/keys.json (root only), by their SHA-256, as a real
provider keeps them: the provider itself can't show a key again.
"""

import hashlib
import http.server
import json
import os
import secrets
import threading
import time
import urllib.parse

STATE = "/var/lib/gift-provider/keys.json"
ADMIN = "/etc/gift-provider/admin.key"
lock = threading.Lock()


def digest(key):
    return hashlib.sha256(key.encode()).hexdigest()


def load():
    with open(STATE, encoding="utf-8") as file:
        return json.load(file)


def save(keys):
    with open(STATE + ".new", "w", encoding="utf-8") as file:
        json.dump(keys, file, indent=1)
    os.replace(STATE + ".new", STATE)


class Handler(http.server.BaseHTTPRequestHandler):
    def answer(self, status, body):
        data = (json.dumps(body) + "\n").encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def bearer(self):
        value = self.headers.get("Authorization", "")
        return value[7:].strip() if value.startswith("Bearer ") else ""

    def key_entry(self, keys):
        found = digest(self.bearer())
        for entry in keys:
            if entry["sha256"] == found:
                return entry
        return None

    def is_admin(self):
        with open(ADMIN, encoding="utf-8") as file:
            return secrets.compare_digest(self.bearer(), file.read().strip())

    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        with lock:
            keys = load()
        if url.path == "/v1/whoami":
            entry = self.key_entry(keys)
            if entry is None:
                return self.answer(401, {"error": "unknown key"})
            return self.answer(200, {"id": entry["id"], "state": entry["state"]})
        if url.path == "/admin/keys":
            if not self.is_admin():
                return self.answer(401, {"error": "not the admin key"})
            return self.answer(
                200,
                [{k: e[k] for k in ("id", "state", "made")} for e in keys],
            )
        return self.answer(404, {"error": "no such page"})

    def do_POST(self):
        url = urllib.parse.urlparse(self.path)
        query = urllib.parse.parse_qs(url.query)
        with lock:
            keys = load()
            if url.path == "/v1/cards":
                entry = self.key_entry(keys)
                if entry is None:
                    return self.answer(401, {"error": "unknown key"})
                if entry["state"] != "active":
                    return self.answer(401, {"error": "key revoked", "id": entry["id"]})
                amount = (query.get("amount") or ["0"])[0]
                card = "GC-" + secrets.token_hex(4).upper()
                return self.answer(
                    200, {"card": card, "amount": amount, "key": entry["id"]}
                )
            if not self.is_admin():
                return self.answer(401, {"error": "not the admin key"})
            if url.path == "/admin/keys":
                key = "gk_live_" + secrets.token_hex(16)
                entry = {
                    "id": "k-" + secrets.token_hex(2),
                    "sha256": digest(key),
                    "state": "active",
                    "made": time.strftime("%Y-%m-%d %H:%M", time.gmtime()),
                }
                keys.append(entry)
                save(keys)
                return self.answer(200, {"id": entry["id"], "key": key})
            parts = url.path.strip("/").split("/")
            if (
                len(parts) == 4
                and parts[:2] == ["admin", "keys"]
                and parts[3] == "revoke"
            ):
                for entry in keys:
                    if entry["id"] == parts[2]:
                        entry["state"] = "revoked"
                        save(keys)
                        return self.answer(200, {"id": entry["id"], "state": "revoked"})
                return self.answer(404, {"error": "no such key"})
        return self.answer(404, {"error": "no such page"})

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    http.server.ThreadingHTTPServer(("127.0.0.1", 9450), Handler).serve_forever()

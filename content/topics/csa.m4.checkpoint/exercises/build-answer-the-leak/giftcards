#!/usr/bin/python3
"""giftcards: the shop's gift-card service, https://gifts.shop.test:8443.

  POST /issue?amount=N   a till asks for a gift card worth N dollars
  GET  /health           "ok"

It issues each card at the gift-card company, with the shop's key for the
company. Its settings are /etc/giftcards/giftcards.conf: the file the key
is read from (read again for every card, so a new key needs no restart),
and the certificate and private key it serves HTTPS with (read when it
starts). systemd runs it as the user giftcards.
"""

import http.server
import json
import ssl
import urllib.error
import urllib.request

CONF = "/etc/giftcards/giftcards.conf"


def settings():
    values = {}
    with open(CONF, encoding="utf-8") as file:
        for line in file:
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                name, _, value = line.partition("=")
                values[name.strip()] = value.strip()
    return values


def provider_key():
    """The key from the key file: a line GIFT_PROVIDER_KEY=..."""
    with open(settings()["provider_key_file"], encoding="utf-8") as file:
        for line in file:
            name, _, value = line.strip().partition("=")
            if name == "GIFT_PROVIDER_KEY":
                return value.strip().strip('"')
    return ""


class Handler(http.server.BaseHTTPRequestHandler):
    def answer(self, status, text):
        data = (text + "\n").encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":
            return self.answer(200, "ok")
        return self.answer(404, "no such page")

    def do_POST(self):
        if not self.path.startswith("/issue"):
            return self.answer(404, "no such page")
        amount = self.path.partition("amount=")[2] or "0"
        try:
            key = provider_key()
        except OSError as error:
            return self.answer(500, f"can't read the gift-card company's key: {error}")
        request = urllib.request.Request(
            f"http://127.0.0.1:9450/v1/cards?amount={amount}",
            method="POST",
            headers={"Authorization": f"Bearer {key}"},
        )
        try:
            with urllib.request.urlopen(request, timeout=5) as reply:
                card = json.load(reply)
        except urllib.error.HTTPError as error:
            why = json.load(error).get("error", "")
            print(f"the gift-card company refused the shop's key: {why}", flush=True)
            return self.answer(
                502, f"the gift-card company refused the shop's key: {why}"
            )
        print(f"issued {card['card']} for {card['amount']}", flush=True)
        return self.answer(200, f"issued {card['card']} for {card['amount']}")

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    conf = settings()
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(conf["tls_cert"], conf["tls_key"])
    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8443), Handler)
    server.socket = context.wrap_socket(server.socket, server_side=True)
    server.serve_forever()

# Attaches the lab's disks at boot (see /usr/local/lib/lab/disks.sh). Part
# of the lab's scenery: on a real server the cloud attaches the volumes.
[Unit]
Description=The lab's disks
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/lab/disks.sh

[Install]
WantedBy=multi-user.target

[Unit]
Description=shop-backup: the shop's backup job
Requires=lab-disks.service
After=lab-disks.service

[Service]
Environment=BACKUP_DIR=/srv/data/backup
# Makes its folder, owned by the shop's account, before it starts.
ExecStartPre=+/usr/bin/install -d -o shop -g shop ${BACKUP_DIR}
ExecStart=/usr/local/bin/shop-backup
User=shop
# The batch jobs have a slice of their own.
Slice=batch.slice
# Keep count of its disk reads and writes (io.stat in its cgroup folder).
IOAccounting=yes
# Its allowance on the data disk: 500 writes a second and 10 MiB a second.
IOWriteIOPSMax=/dev/lab/data 500
IOWriteBandwidthMax=/dev/lab/data 10485760

[Install]
WantedBy=multi-user.target

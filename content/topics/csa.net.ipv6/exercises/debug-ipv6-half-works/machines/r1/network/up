# r1's network settings, run at every boot: the office's router.
# The office LAN: IPv4, and the office's IPv6 subnet.
ip addr add 192.168.10.1/24 dev lan
ip addr add 2001:db8:42:a::1/64 dev lan
# The line to the ISP.
ip addr add 198.51.100.2/30 dev wan
ip addr add 2001:db8:ffff:1::2/64 dev wan
ip route add default via 198.51.100.1
ip route add default via 2001:db8:ffff:1::1

# The network of "Advertise the office's subnet": a new office, its router,
# the ISP, a narrow link inside the ISP, and a server in the cloud.
#
#   h1, h2 --[office]-- r1 --- isp ==(1400-byte link)== core --- web
#   192.168.30.0/24     wan                                      203.0.113.80
#   (IPv6 from r1's     198.51.100.2/30                          2001:db8:80::80
#    advertisements)    2001:db8:ffff:1::2/64
#
# The company's site is 2001:db8:77::/48, and the ISP routes all of it to
# r1. r1's addresses and routes are in its /etc/network/up, its firewall
# and NAT in its /etc/nftables.conf; its forwarding (its /etc/sysctl.d)
# and its router advertisements (its /etc/radvd.conf) are the learner's.
# The laptops' IPv4 is given here, as the office's DHCP server would give it.
machine h1
machine h2
machine r1
machine isp router
machine core router
machine web

lan office h1:eth0=192.168.30.11/24 h2:eth0=192.168.30.12/24 r1:lan
link r1:wan isp:cust=198.51.100.1/30,2001:db8:ffff:1::1/64
link isp:core=198.51.100.5/30,2001:db8:ffff:2::1/64 core:edge=198.51.100.6/30,2001:db8:ffff:2::2/64
link core:srv=203.0.113.1/24,2001:db8:80::1/64 web:eth0=203.0.113.80/24,2001:db8:80::80/64
mtu isp core 1400
mtu core edge 1400

route h1 default via 192.168.30.1
route h2 default via 192.168.30.1
route isp default via 198.51.100.6
route isp default via 2001:db8:ffff:2::2
route isp 2001:db8:77::/48 via 2001:db8:ffff:1::2
route core 198.51.100.0/30 via 198.51.100.5
route core 2001:db8:77::/48 via 2001:db8:ffff:2::1
route core 2001:db8:ffff:1::/64 via 2001:db8:ffff:2::1
route web default via 203.0.113.1
route web default via 2001:db8:80::1

run r1 nftables radvd
run web web-svc

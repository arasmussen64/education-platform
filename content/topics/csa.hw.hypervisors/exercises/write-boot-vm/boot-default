#!/bin/bash
# boot-default: boot the small VM in /opt/vm without choosing any hardware,
# so QEMU gives it its defaults. It prints the command before running it.
# The guest reports on itself and switches off.
set -euo pipefail
echo '+ qemu-system-x86_64 -accel tcg -nographic -no-reboot -kernel /opt/vm/vmlinuz -initrd /opt/vm/initramfs.cpio.gz -append "console=ttyS0 quiet panic=-1"'
qemu-system-x86_64 -accel tcg -nographic -no-reboot \
  -kernel /opt/vm/vmlinuz -initrd /opt/vm/initramfs.cpio.gz \
  -append "console=ttyS0 quiet panic=-1"

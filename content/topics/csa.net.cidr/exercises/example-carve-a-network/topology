# The network of "Carve a network": one router and three networks, the
# third with no address yet.
#
#   h1 --[lana]--+
#                +-- r1
#   h2 --[lanb]--+    |
#                   [lanc]   (empty: no address yet)
machine r1 router
machine h1
machine h2

lan lana r1:lana=10.20.1.1/24 h1:eth0=10.20.1.10/24
lan lanb r1:lanb=10.20.2.1/24 h2:eth0=10.20.2.10/24
lan lanc r1:lanc

route h1 default via 10.20.1.1
route h2 default via 10.20.2.1

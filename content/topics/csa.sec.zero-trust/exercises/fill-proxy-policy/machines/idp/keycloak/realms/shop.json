{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "all",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "groups": [
    {
      "name": "staff"
    },
    {
      "name": "hr"
    },
    {
      "name": "warehouse"
    }
  ],
  "users": [
    {
      "id": "0a000000-0000-4000-8000-000000000001",
      "username": "ana",
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Lima",
      "email": "ana@shop.test",
      "emailVerified": true,
      "groups": [
        "/staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${ANA_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "0a000000-0000-4000-8000-000000000002",
      "username": "ben",
      "enabled": true,
      "firstName": "Ben",
      "lastName": "Okoro",
      "email": "ben@shop.test",
      "emailVerified": true,
      "groups": [
        "/warehouse"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${BEN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "0a000000-0000-4000-8000-000000000003",
      "username": "hana",
      "enabled": true,
      "firstName": "Hana",
      "lastName": "Sato",
      "email": "hana@shop.test",
      "emailVerified": true,
      "groups": [
        "/staff",
        "/hr"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${HANA_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "access-proxy",
      "name": "The access proxy in front of the shop's apps",
      "enabled": true,
      "publicClient": false,
      "secret": "${ACCESS_PROXY_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://apps.shop.test/oauth2/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "multivalued": "true",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    }
  ]
}

# payroll: the shop's payroll app. It trusts the X-User header to say who
# is asking, because the access proxy is meant to be the only thing that
# can reach it.
server {
    listen 8081 default_server;
    default_type text/plain;
    location / {
        return 200 "payroll: hello $http_x_user\n";
    }
}

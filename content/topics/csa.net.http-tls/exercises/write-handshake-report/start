#!/bin/bash
# The lab's first program: starts the two example servers on 127.0.0.1 for
# the learner to try handshake-report on, then waits for ever, as every
# plain lab does. It runs again when the lab is restarted.
#   8443: TLS 1.3 only, ALPN h2 or http/1.1, www.shop.test's certificate,
#         with its OCSP answer stapled;
#   9443: TLS 1.2 only, no ALPN, legacy.shop.test's certificate, and
#         api.shop.test's for a client whose SNI asks for that name.
. /usr/local/lib/lab/tls-servers
d=/usr/local/lib/lab/example
serve 8443 "$d" www -tls1_3 -alpn h2,http/1.1 -status_file "$d/www.ocsp"
serve 9443 "$d" legacy -tls1_2 -servername api.shop.test -cert2 "$d/api.pem" -key2 "$d/api.key"
exec sleep infinity

#!/bin/bash
# Usage: from-office COMMAND...
# Runs COMMAND as if from a laptop in the office: another machine, on the
# 10.0.9.0/24 network, plugged into this server's eth1, where this server
# is 10.0.9.1. The office is a network namespace, the same mechanism a
# container uses for its own interfaces and ports; ip netns exec runs a
# command inside one.
exec sudo ip netns exec office "$@"

#!/usr/bin/python3
"""ledger: the accounts ledger (a stand-in). It answers every request on
port 7000, on every address, with one line. A request for /crash makes it
exit with an error, as a crash would, so its restart policy can be tried."""

import os
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

BODY = b"ledger ok\n"


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        crash = self.path == "/crash"
        body = b"ledger: crashing on request\n" if crash else BODY
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        if crash:
            self.wfile.flush()
            print("ledger: fatal: crashed on request (/crash)", file=sys.stderr, flush=True)
            os._exit(1)

    def log_message(self, *args):
        pass


print("ledger listening on 0.0.0.0:7000", flush=True)
HTTPServer(("0.0.0.0", 7000), Handler).serve_forever()

[Unit]
Description=shop-api: the shop's API
After=network.target

[Service]
# Wrong: the binary is /usr/local/bin/shop-api, not shop-api-typo, so the
# service fails to start (203/EXEC, "No such file or directory") and stays
# failed. No Restart= here: a unit that can't exec would only flap and trip
# systemd's start limit, which hides the real symptom.
ExecStart=/usr/local/bin/shop-api-typo
User=shop

[Install]
WantedBy=multi-user.target

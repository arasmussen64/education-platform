# Makes the shop's data area at boot (see /usr/local/lib/lab/lab-disk.sh).
# Part of the lab's scenery.
[Unit]
Description=The lab's scenery: the shop's data area
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/lab/lab-disk.sh

[Install]
WantedBy=multi-user.target

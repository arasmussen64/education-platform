[Unit]
Description=shop-search: the shop's search service
After=network.target

[Service]
ExecStart=/usr/local/bin/shop-search
User=shop
# shop-search shares this machine with the API, so it runs inside limits.
MemoryMax=128M
MemorySwapMax=0
CPUQuota=5%
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

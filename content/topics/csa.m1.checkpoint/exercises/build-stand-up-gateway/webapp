#!/usr/bin/python3
"""webapp: a small web service that answers every request with one line.
Which service it is comes from its unit: $NAME is what it calls itself and
$PORT is where it listens (every interface). The checkpoint's sibling and
fresh-version servers all run this under their own names."""

import os
from http.server import BaseHTTPRequestHandler, HTTPServer

NAME = os.environ.get("NAME", "webapp")
PORT = int(os.environ.get("PORT", "8000"))
BODY = f"{NAME} ok\n".encode()


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(BODY)))
        self.end_headers()
        self.wfile.write(BODY)

    def log_message(self, *args):
        pass


print(f"{NAME} listening on 0.0.0.0:{PORT}", flush=True)
HTTPServer(("0.0.0.0", PORT), Handler).serve_forever()

#!/usr/bin/python3
"""gateway: the company's API gateway (a stand-in). It answers on two ports:
requests on 9090 and its health page on 9191. Which address it listens on
comes from its unit: $BIND, every address (0.0.0.0) unless told otherwise."""

import os
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer

BIND = os.environ.get("BIND", "0.0.0.0")
PAGES = {9090: b"gateway ok\n", 9191: b"gateway healthy\n"}


def handler_for(body):
    """A request handler that answers every GET with one line."""

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    return Handler


# Both ports are opened before either starts answering, so a port that is
# taken stops the whole service with an error instead of half of it.
servers = [HTTPServer((BIND, port), handler_for(body)) for port, body in PAGES.items()]
print(f"gateway listening on {BIND}:9090 (requests) and {BIND}:9191 (health)", flush=True)
for server in servers[1:]:
    threading.Thread(target=server.serve_forever, daemon=True).start()
servers[0].serve_forever()

#!/bin/bash
# The orders site's stock page: it asks the stock API, as the signed-in
# person, with the access token the identity provider gave the site for them.
printf 'Content-Type: text/plain\n\n'
answer=$(curl -s -m 5 -w '\n%{http_code}' -H "Authorization: Bearer $OIDC_access_token" https://api.shop.test/stock/level)
status=${answer##*$'\n'}
body=${answer%$'\n'*}
if [[ $status == 200 ]]; then
  echo "user=$REMOTE_USER"
  echo "level=$(echo "$body" | python3 -c 'import json, sys; print(json.load(sys.stdin)["level"])')"
else
  echo "the stock API answered $status: $body"
fi

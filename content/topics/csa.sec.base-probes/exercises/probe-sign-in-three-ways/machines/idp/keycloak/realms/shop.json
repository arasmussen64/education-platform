{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "all",
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "groups": [{ "name": "staff" }, { "name": "warehouse" }],
  "users": [
    {
      "id": "0a000000-0000-4000-8000-000000000001",
      "username": "ana",
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Lima",
      "email": "ana@shop.test",
      "emailVerified": true,
      "groups": ["/staff"],
      "credentials": [{ "type": "password", "value": "${ANA_PASSWORD}", "temporary": false }]
    },
    {
      "id": "0a000000-0000-4000-8000-000000000002",
      "username": "ben",
      "enabled": true,
      "firstName": "Ben",
      "lastName": "Okoro",
      "email": "ben@shop.test",
      "emailVerified": true,
      "groups": ["/warehouse"],
      "credentials": [{ "type": "password", "value": "${BEN_PASSWORD}", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "shop-web",
      "name": "The orders site",
      "enabled": true,
      "publicClient": false,
      "secret": "${SHOP_WEB_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://app.shop.test/oidc/callbak"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "multivalued": "true",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "stock-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://apis.shop.test",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}

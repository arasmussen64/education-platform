# When crl-fetch@MACHINE.service runs: 45 seconds after every boot, and
# then half an hour after each run. A CRL here lasts 2 hours and a new one
# comes out every hour, so a fetch can fail once and the next still arrives
# before the copy on this machine runs out.
[Unit]
Description=Fetch the CA's CRLs on %i every half hour (the labs' fast clock)

[Timer]
OnBootSec=45s
OnUnitActiveSec=30min

[Install]
WantedBy=timers.target

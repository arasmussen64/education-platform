# One run of /usr/local/bin/publish-crl on a machine, which makes the CAs'
# next CRLs and puts them where they are served. crl-publish@MACHINE.timer
# starts it every hour, and it also runs once at every boot, before
# anything asks for a CRL. "systemctl status crl-publish@ca" shows the last
# run.
[Unit]
Description=Publish the CAs' next CRLs on %i
After=netlab.service
Requires=netlab.service

[Service]
Type=oneshot
SyslogIdentifier=%p@%i
ExecStart=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/local/bin/publish-crl

[Install]
WantedBy=multi-user.target

# When crl-publish@MACHINE.service runs: half a minute after every boot,
# and then an hour after each run. A CRL here lasts 2 hours (the labs' fast
# clock), so there is always a whole hour left on the one being served.
# A real CA's figures are days: a CRL that lasts 7 days, published every 3.5.
[Unit]
Description=Publish the CA's CRL on %i every hour (the labs' fast clock)

[Timer]
OnBootSec=30s
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target

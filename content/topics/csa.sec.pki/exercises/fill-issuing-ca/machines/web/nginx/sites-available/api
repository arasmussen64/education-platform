# The shop's API on web: api.shop.test. It sends its own certificate
# followed by its issuing CA's, the full chain, which make-services-ca
# puts in place.
server {
    listen 443 ssl;
    server_name api.shop.test;
    ssl_certificate     /etc/nginx/tls/api-fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/api.key;
    root /srv/www/api;
}

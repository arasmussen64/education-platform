# The shop's issuing CA for its own servers, on the machine "ca": what
# "openssl ca" reads. It signs servers' certificates and its own CRL.

[ ca ]
default_ca = shop_services

[ shop_services ]
dir               = /etc/shop-ca
certificate       = $dir/services.pem     # the CA's own certificate, signed by the root
private_key       = $dir/services.key     # and its key
database          = $dir/index.txt        # one line for every certificate it has signed
new_certs_dir     = $dir/newcerts         # a copy of each, named by serial number
crlnumber         = $dir/crlnumber        # the number of the next CRL
rand_serial       = yes                   # serial numbers are random, never counted up
default_md        = sha256
default_days      = 90                    # a server's certificate lasts 90 days
default_crl_days  = 30                    # this lab's CRL is made by hand, so it lasts 30 days
policy            = policy_server
unique_subject    = no
copy_extensions   = copy                  # the names a request asks for (its subjectAltName) are copied in

# What a request's subject must hold.
[ policy_server ]
commonName = supplied

# What goes into every server's certificate, whatever the request asked
# for: it is not a CA, it may prove a server and nothing else, and it says
# where a client finds this CA's CRL and its OCSP responder.
[ server ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
crlDistributionPoints  = URI:___
authorityInfoAccess    = OCSP;URI:___

# The shop's price-feed client on a machine: "systemctl status feed-client@app".
# Its settings are the machine's own /etc/shop/feed.conf.
[Unit]
Description=The shop's price-feed client on %i
After=netlab.service
Requires=netlab.service
PartOf=netlab.service

[Service]
# Journal lines say which service and machine wrote them ("feed-client@app").
SyslogIdentifier=%p@%i
ExecStart=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/local/bin/feed-client
Restart=on-failure

[Install]
WantedBy=multi-user.target

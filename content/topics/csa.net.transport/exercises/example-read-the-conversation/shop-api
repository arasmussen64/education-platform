#!/usr/bin/python3
"""shop-api: the shop's order service (a stand-in; part of the lab's scenery).

It listens on 127.0.0.1:8080 on its machine and keeps one pooled connection
to the orders database: each GET /order sends one line over it and waits
for the one-line answer. Its settings are /etc/shop/api.conf, read when it
starts; a later line for the same name wins.

  GET /order           ->  {"ok": true, "order": 3, "port": 41522, "seconds": 0.001}
                           or {"ok": false, ..., "error": "[Errno 104] Connection reset by peer"}
  GET /health/standby  ->  {"standby": "up", ...} or {"standby": "down", ..., "error": "timed out"}

"port" is the connection's own port on this machine, so two orders that
show the same port went over the same connection. With db_pool = off, each
order opens a connection of its own and closes it. /health/standby tries
to connect to standby_host:standby_port, waiting standby_connect_timeout
seconds, or, without that setting, as long as the system's SYN retries last.
"""

import json
import socket
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = "/etc/shop/api.conf"


def read_conf():
    settings = {}
    with open(CONF, encoding="utf-8") as conf:
        for line in conf:
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                name, value = (part.strip() for part in line.split("=", 1))
                settings[name] = value
    return settings


SETTINGS = read_conf()
LOCK = threading.Lock()
POOL = {"sock": None, "file": None}
COUNT = {"orders": 0}


def setting(name, default=None):
    value = SETTINGS.get(name, "")
    return value if value != "" else default


def keepalive_words(sock):
    """What the socket's keepalive is, in words, for the log."""
    if not sock.getsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE):
        return "keepalive off"
    idle = sock.getsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE)
    interval = sock.getsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL)
    count = sock.getsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT)
    return f"keepalive on: first probe after {idle} s of quiet, then every {interval} s, {count} probes"


def connect():
    sock = socket.create_connection(
        (setting("db_host"), int(setting("db_port"))), timeout=5
    )
    if setting("db_keepalive", "off") == "on":
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        for option, name in (
            (socket.TCP_KEEPIDLE, "db_keepalive_idle"),
            (socket.TCP_KEEPINTVL, "db_keepalive_interval"),
            (socket.TCP_KEEPCNT, "db_keepalive_count"),
        ):
            if setting(name):
                sock.setsockopt(socket.IPPROTO_TCP, option, int(setting(name)))
    sock.settimeout(float(setting("db_query_timeout", "5")))
    print(
        f"connected to the database from port {sock.getsockname()[1]} ({keepalive_words(sock)})",
        flush=True,
    )
    return sock


def close_pool():
    if POOL["sock"] is not None:
        POOL["sock"].close()
    POOL["sock"] = None


def order(number):
    with LOCK:
        started = time.time()
        port = None
        try:
            if POOL["sock"] is None:
                POOL["sock"] = connect()
                POOL["file"] = POOL["sock"].makefile("rwb", buffering=0)
            port = POOL["sock"].getsockname()[1]
            POOL["sock"].sendall(b"order %d\n" % number)
            answer = POOL["file"].readline()
            if not answer:
                raise ConnectionError("the database closed the connection")
            if setting("db_pool", "on") == "off":
                close_pool()
            return {"ok": True, "order": number, "port": port,
                    "seconds": round(time.time() - started, 3)}
        except Exception as error:  # noqa: BLE001 - every failure is reported to the caller
            took = time.time() - started
            print(f"order {number} failed after {took:.1f} s: {error}", flush=True)
            close_pool()
            return {"ok": False, "order": number, "port": port, "error": str(error),
                    "seconds": round(took, 3)}


def standby():
    host = setting("standby_host")
    if not host:
        return {"standby": "none", "error": "no standby_host in the settings"}
    wait = setting("standby_connect_timeout")
    started = time.time()
    try:
        sock = socket.create_connection(
            (host, int(setting("standby_port", "5432"))),
            timeout=float(wait) if wait else None,
        )
        sock.close()
        return {"standby": "up", "seconds": round(time.time() - started, 3)}
    except Exception as error:  # noqa: BLE001 - every failure means the standby is down
        took = time.time() - started
        print(f"the standby at {host} is down: no connection after {took:.1f} s: {error}", flush=True)
        return {"standby": "down", "seconds": round(took, 3), "error": str(error)}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        if self.path == "/order":
            COUNT["orders"] += 1
            body = order(COUNT["orders"])
        elif self.path == "/health/standby":
            body = standby()
        else:
            body = {"orders": COUNT["orders"]}
        data = json.dumps(body).encode() + b"\n"
        self.send_response(200 if body.get("ok", True) else 502)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


print(f"shop-api: taking orders on 127.0.0.1:8080; the database is {setting('db_host')}:{setting('db_port')}", flush=True)
ThreadingHTTPServer(("127.0.0.1", 8080), Handler).serve_forever()

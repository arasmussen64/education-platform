#!/usr/bin/python3
"""stock-sync: keeps the shop's stock in step with the supplier's (a stand-in;
part of the lab's scenery).

It keeps one connection open to the supplier's stock API and sends a sync
over it when asked: GET http://127.0.0.1:8081/sync on its machine sends one
line and waits for the one-line answer. Its settings are
/etc/shop/stock-sync.conf, read when it starts; a later line for the same
name wins. It only switches TCP keepalive on or off: the timers are the
system's (net.ipv4.tcp_keepalive_*).

  GET /sync  ->  {"ok": true, "sync": 3, "port": 41522, "seconds": 0.001}
                 or {"ok": false, ..., "error": "timed out"}

"port" is the connection's own port on this machine, so two syncs that
show the same port went over the same connection.
"""

import json
import socket
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = "/etc/shop/stock-sync.conf"


def read_conf():
    settings = {}
    with open(CONF, encoding="utf-8") as conf:
        for line in conf:
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                name, value = (part.strip() for part in line.split("=", 1))
                settings[name] = value
    return settings


SETTINGS = read_conf()
HOST, PORT = SETTINGS.get("supplier", "10.0.2.30:6000").rsplit(":", 1)
KEEPALIVE = SETTINGS.get("keepalive", "off")
if KEEPALIVE not in ("on", "off"):
    print(f"stock-sync: keepalive = {KEEPALIVE} isn't on or off, so it stays off", flush=True)
    KEEPALIVE = "off"
LOCK = threading.Lock()
POOL = {"sock": None, "file": None}
COUNT = {"syncs": 0}


def connect():
    sock = socket.create_connection((HOST, int(PORT)), timeout=5)
    if KEEPALIVE == "on":
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    sock.settimeout(float(SETTINGS.get("timeout") or 4))
    print(f"connected to the supplier from port {sock.getsockname()[1]} (keepalive {KEEPALIVE})", flush=True)
    return sock


def sync(number):
    with LOCK:
        started = time.time()
        port = None
        try:
            if POOL["sock"] is None:
                POOL["sock"] = connect()
                POOL["file"] = POOL["sock"].makefile("rwb", buffering=0)
            port = POOL["sock"].getsockname()[1]
            POOL["sock"].sendall(b"sync %d\n" % number)
            answer = POOL["file"].readline()
            if not answer:
                raise ConnectionError("the supplier closed the connection")
            return {"ok": True, "sync": number, "port": port,
                    "seconds": round(time.time() - started, 3)}
        except Exception as error:  # noqa: BLE001 - every failure is reported to the caller
            took = time.time() - started
            print(f"sync {number} failed after {took:.1f} s: {error}", flush=True)
            if POOL["sock"] is not None:
                POOL["sock"].close()
            POOL["sock"] = None
            return {"ok": False, "sync": number, "port": port, "error": str(error),
                    "seconds": round(took, 3)}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        if self.path == "/sync":
            COUNT["syncs"] += 1
            body = sync(COUNT["syncs"])
        else:
            body = {"syncs": COUNT["syncs"]}
        data = json.dumps(body).encode() + b"\n"
        self.send_response(200 if body.get("ok", True) else 502)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


print(f"stock-sync: syncing on 127.0.0.1:8081; the supplier is {HOST}:{PORT}, keepalive {KEEPALIVE}", flush=True)
ThreadingHTTPServer(("127.0.0.1", 8081), Handler).serve_forever()

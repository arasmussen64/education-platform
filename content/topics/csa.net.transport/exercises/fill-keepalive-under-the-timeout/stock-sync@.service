# The shop's stock sync on a machine: "systemctl status stock-sync@app".
# Its settings are the machine's own /etc/shop/stock-sync.conf.
[Unit]
Description=The shop's stock sync on %i
After=netlab.service
Requires=netlab.service
PartOf=netlab.service

[Service]
# Journal lines say which service and machine wrote them ("stock-sync@app").
SyslogIdentifier=%p@%i
ExecStart=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/local/bin/stock-sync
Restart=on-failure

[Install]
WantedBy=multi-user.target

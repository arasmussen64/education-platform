// The shop's order system: who there is, what there is, what can be asked.
// A role can sit inside another role: supervisors are support staff too.
entity Role in [Role];
entity Staff in [Role] { store: String };
entity Order { store: String, amount: Long, handled_by: Staff };

action view, refund, export appliesTo {
  principal: [Staff],
  resource: [Order],
  context: { mfa: Bool }
};

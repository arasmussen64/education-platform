// The warehouse's stock system: who there is, what there is, what can be asked.
entity Role;
entity Worker in [Role] { zone: String };
entity Bin { zone: String };
// A correction to a bin's stock count, waiting for approval.
entity Adjustment { zone: String, made_by: Worker };

action pick, adjust, audit appliesTo { principal: [Worker], resource: [Bin] };
action approve appliesTo { principal: [Worker], resource: [Adjustment] };

# Starts the shop's workers at boot, as the learner, with /run/shop for
# their PID files. Part of the lab's scenery, not of the lesson.
[Unit]
Description=The shop's workers

[Service]
Type=oneshot
RemainAfterExit=yes
User=learner
RuntimeDirectory=shop
RuntimeDirectoryPreserve=yes
ExecStart=/srv/shop/start-workers

[Install]
WantedBy=multi-user.target

# Starts the runaway script at boot, detached, the way a colleague's
# backgrounded command would have been left behind. Part of the lab's
# scenery, not of the lesson.
[Unit]
Description=A report job someone left running

[Service]
Type=oneshot
RemainAfterExit=yes
User=learner
ExecStart=/bin/bash -c 'setsid /srv/tools/runaway.sh > /dev/null 2>&1 < /dev/null &'

[Install]
WantedBy=multi-user.target

#!/bin/bash
# Starts the shop's order service. Its three queues are got ready first, all
# at the same time, and then the orders program takes over from this script.
/srv/shop/bin/prepare-queue new 2 &
/srv/shop/bin/prepare-queue paid 3 &
/srv/shop/bin/prepare-queue shipped 4 &
wait
exec /srv/shop/bin/orders

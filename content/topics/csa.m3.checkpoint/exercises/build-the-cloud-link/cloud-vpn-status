#!/bin/bash
# Usage: cloud-vpn-status
# The provider's view of the data centre's VPN, as a cloud's console shows a VPN
# connection's tunnels: its gateway's IKE and CHILD SAs, from its own
# strongSwan (swanctl --list-sas on the machine cloud). Read-only: the
# provider's gateway isn't yours to change.
set -euo pipefail
exec on cloud swanctl --list-sas

# The network of "Big downloads hang": the shop's office, a GRE tunnel
# across the internet, and the shop's cloud network.
#
#   office --- r1 ==(wan: the internet, GRE tunnel gre1 inside)== r2 --[cloud]-- web, files
#                                                                  |
#                                                                  +--(prn)-- printer
#
# Only the cables are here. Each machine's addresses, routes and tunnel are
# its own settings, in its /etc/network/up; web's firewall is its
# /etc/nftables.conf.
machine office
machine r1 router
machine r2 router
machine web
machine files
machine printer

link office:eth0 r1:eth0
link r1:wan r2:wan
lan cloud r2:lan web:eth0 files:eth0
link r2:prn printer:eth0

run web nginx nftables
run files nginx

# srv's connection holder (the base's holdserver): it accepts connections
# on ports 9000 and 9001 and keeps every one open, so each keeps its place
# in a NAT's table. "systemctl status holdserver-srv".
[Unit]
Description=Connection holder on srv, ports 9000 and 9001
After=netlab.service
Requires=netlab.service
PartOf=netlab.service

[Service]
ExecStart=/usr/sbin/ip netns exec srv /usr/local/lib/netlab/lab-enter srv /usr/local/bin/holdserver 9000 9001
Restart=on-failure

[Install]
WantedBy=multi-user.target

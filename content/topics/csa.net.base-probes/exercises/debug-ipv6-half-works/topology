# The network of "IPv6 half works": a dual-stack office behind its router,
# the ISP, a narrow link inside the ISP, and a server in the cloud.
#
#   h1, h2 --[office]-- r1 --- isp ==(1400-byte link)== core --- web
#   192.168.10.0/24     wan                                      203.0.113.80
#   (IPv6 from r1's     198.51.100.2/30                          2001:db8:80::80
#    advertisements)    2001:db8:ffff:1::2/64
#
# r1 is the office's router, and its forwarding is its own business: its
# /etc/sysctl.d turns it on (netlab's router role would do it for r1, as it
# does for the ISP's routers). r1's addresses and routes are in its
# /etc/network/up; its firewall and NAT in its /etc/nftables.conf, its
# router advertisements in its /etc/radvd.conf. The laptops' IPv4 is given
# here, as the office's DHCP server would give it.
machine h1
machine h2
machine r1
machine isp router
machine core router
machine web

lan office h1:eth0=192.168.10.11/24 h2:eth0=192.168.10.12/24 r1:lan
link r1:wan isp:cust=198.51.100.1/30,2001:db8:ffff:1::1/64
link isp:core=198.51.100.5/30,2001:db8:ffff:2::1/64 core:edge=198.51.100.6/30,2001:db8:ffff:2::2/64
link core:srv=203.0.113.1/24,2001:db8:80::1/64 web:eth0=203.0.113.80/24,2001:db8:80::80/64
mtu isp core 1400
mtu core edge 1400

route h1 default via 192.168.10.1
route h2 default via 192.168.10.1
# The ISP routes the office's IPv6 block, 2001:db8:42::/48, to r1.
route isp default via 198.51.100.6
route isp default via 2001:db8:ffff:2::2
route isp 2001:db8:42::/48 via 2001:db8:ffff:1::2
route core 198.51.100.0/30 via 198.51.100.5
route core 2001:db8:42::/48 via 2001:db8:ffff:2::1
route core 2001:db8:ffff:1::/64 via 2001:db8:ffff:2::1
route web default via 203.0.113.1
route web default via 2001:db8:80::1
# web also answers for 2001:db8:80::1000 to ::1fff, so a check can send to
# an address nobody has sent to before.
route web local 2001:db8:80::1000/116 dev lo

run r1 nftables radvd

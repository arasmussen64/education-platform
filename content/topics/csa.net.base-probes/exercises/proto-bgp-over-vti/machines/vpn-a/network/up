# vpn-a's own network settings, run at every boot (netlab's network file).
# Its tunnel interface to the cloud: a VTI, whose traffic IPsec protects.
# Key 42 is the mark that ties it to the IPsec SA whose mark_in and
# mark_out are 42.
ip link add vti0 type vti local 198.51.100.2 remote 203.0.113.2 key 42
ip addr add 169.254.10.1/30 dev vti0
ip link set vti0 up

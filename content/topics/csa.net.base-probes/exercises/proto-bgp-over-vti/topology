# The network of the VTI probe: BGP over a route-based IPsec tunnel.
#
#   host-a --[site-a]-- vpn-a ==(internet: isp)== vpn-b --[site-b]-- host-b
#   10.1.0.10           10.1.0.1                   10.2.0.1           10.2.0.10
#
# vpn-a is the shop's VPN gateway, the learner's; its tunnel interface, vti0,
# is made by its own /etc/network/up. vpn-b stands in for a cloud's VPN
# gateway (AS 64512, a private AS number) and isn't the learner's: its
# tunnel interface is scenery, here.
machine host-a
machine vpn-a router
machine isp router
machine vpn-b router
machine host-b

lan site-a host-a:eth0=10.1.0.10/24 vpn-a:eth1=10.1.0.1/24
link vpn-a:eth0=198.51.100.2/30 isp:eth1=198.51.100.1/30
link vpn-b:eth0=203.0.113.2/30 isp:eth2=203.0.113.1/30
lan site-b host-b:eth0=10.2.0.10/24 vpn-b:eth1=10.2.0.1/24
route host-a default via 10.1.0.1
route host-b default via 10.2.0.1
netem isp eth2 delay 20ms

# The cloud's end of the tunnel. Key 7 is the mark that ties vti0 to the
# IPsec SA whose mark_in and mark_out are 7 (vpn-b's swanctl file).
tunnel vpn-b vti0 vti local 203.0.113.2 remote 198.51.100.2 key 7 addr 169.254.10.2/30

run vpn-a frr strongswan
run vpn-b frr strongswan nftables

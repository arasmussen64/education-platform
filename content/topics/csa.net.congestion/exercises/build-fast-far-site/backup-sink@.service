# The DR site's backup receiver on a machine: iperf3's server on port 5201,
# which the nightly archive is sent to. "systemctl status backup-sink@dr1";
# "journalctl -u backup-sink@dr1" shows what it received from each test,
# with --forceflush so each line reaches the journal as it is printed.
[Unit]
Description=The backup receiver on %i (iperf3 -s)
After=netlab.service
Requires=netlab.service
PartOf=netlab.service

[Service]
SyslogIdentifier=%p@%i
ExecStart=/usr/sbin/ip netns exec %i /usr/local/lib/netlab/lab-enter %i /usr/bin/iperf3 -s --forceflush
Restart=on-failure

[Install]
WantedBy=multi-user.target

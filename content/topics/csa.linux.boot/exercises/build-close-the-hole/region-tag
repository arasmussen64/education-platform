#!/bin/bash
# region-tag: prints the instance's region, read from the metadata service,
# so the shop's reports can be tagged with where they came from. Written
# back when the metadata service answered any plain request.
set -euo pipefail
imds=http://169.254.169.254
region=$(curl -s "$imds/latest/meta-data/placement/region")
echo "region: $region"

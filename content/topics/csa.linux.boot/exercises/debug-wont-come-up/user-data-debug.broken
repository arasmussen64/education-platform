#cloud-config
# The shop's web servers set themselves up from this on first boot: the
# report tool, its settings, and the readiness marker the load balancer
# looks for.
users:
  - name: ben
    groups: sudo
    shell: /bin/bash
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeKeyForTheLabOnly0000000000000000000000000 ben@laptop
packages:
  - shop-reprot
write_files:
  - path: /etc/shop/report.conf
    content: |
      SHOP_TIER=web
runcmd:
  - touch /var/lib/shop-data/ready

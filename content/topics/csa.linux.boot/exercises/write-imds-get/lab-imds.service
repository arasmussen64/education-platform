# The instance metadata service stand-in (see /usr/local/bin/lab-imds).
# Part of the lab's scenery: on a real instance the cloud answers at this
# address from outside the machine.
[Unit]
Description=lab-imds: the instance metadata service (stand-in)
After=lab-cloud.service
Requires=lab-cloud.service

[Service]
ExecStart=/usr/local/bin/lab-imds
Restart=on-failure

[Install]
WantedBy=multi-user.target

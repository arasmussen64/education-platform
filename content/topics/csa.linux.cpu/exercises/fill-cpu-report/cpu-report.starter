#!/bin/bash
# Usage: cpu-report SERVICE
# How the CPUs are doing, and whether SERVICE is being throttled.
service="$1"
echo "cpus: $(...)"
echo "load: $(awk '{print ...}' /proc/loadavg)"
echo "top process: $(ps -eo comm,%cpu --sort=... | awk 'NR == 2 {print $1, $2 "%"}')"
echo "throttled periods of $service: $(awk '/^.../ {print $2}' /sys/fs/cgroup/system.slice/$service.service/cpu.stat)"

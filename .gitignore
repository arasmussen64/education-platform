# Dependencies
node_modules/
.pnpm-store/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.ipynb_checkpoints/

# Builds and caches
dist/
build/
.vite/
coverage/
.cache/
*.tsbuildinfo

# Environment and secrets (keep .env.example committed)
.env
.env.*
!.env.example

# Supabase local state
supabase/.branches/
supabase/.temp/

# Cloudflare local state and secrets
.wrangler/
.dev.vars

# Logs
*.log
npm-debug.log*
# ...but a lab's recorded log is content a lab copies into its image
# (csa.net.troubleshooting's monitor log was left out by the rule above, and
# its image wouldn't build in CI).
!content/topics/**/*.log

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code personal settings, and the worktrees its agents work in
.claude/settings.local.json
.claude/worktrees/

# ML data and model files (large; keep out of git)
ml/data/
ml/models/
*.ckpt
*.pt
*.safetensors

// How Cloudflare serves the app: the built files in dist/ as static assets,
// on the free plan (ADR-0005, ADR-0007). Cloudflare builds and deploys this
// automatically on every merge to main (see docs/setup.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the project name in the Cloudflare dashboard. It's also the
  // first part of the free address: <name>.<account>.workers.dev
  "name": "education-platform",
  "compatibility_date": "2026-11-01",
  // Don't send Wrangler usage statistics to Cloudflare.
  "send_metrics": false,
  // Serve the app at https://education-platform.arasmussen64.workers.dev, and
  // give each pull request its own preview address. Keeping these here means
  // a deploy can never switch them off.
  "workers_dev": true,
  "preview_urls": true,
  // Cloudflare builds pull requests with `wrangler preview`, which needs this
  // block, even empty. Settings for previews only would go inside it.
  "previews": {},
  "assets": {
    "directory": "./dist",
    // Addresses that aren't files (like /topic/py.variables) get index.html,
    // so the app's own router can show the right page.
    "not_found_handling": "single-page-application",
  },
}
